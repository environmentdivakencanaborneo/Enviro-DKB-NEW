{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Information stored on the user profile",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "company": { "type": "string" },
        "role": { "type": "string" }
      },
      "required": ["name", "email", "company", "role"]
    },
    "Wastewater": {
      "title": "Wastewater Monitoring Entry",
      "description": "Mining wastewater pH, heavy metal indicators, and sampling evidence",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "location": { "type": "string" },
        "officer": { "type": "string" },
        "ph": { "type": "number" },
        "tss": { "type": "number" },
        "debit": { "type": "number" },
        "fe": { "type": "number" },
        "mn": { "type": "number" },
        "status": { "type": "string", "enum": ["Safe", "Warning", "Exceeded"] },
        "monitoringType": { "type": "string", "enum": ["Harian", "Bulanan"] },
        "sampleTime": { "type": "string" },
        "weather": { "type": "string", "enum": ["Cerah", "Berawan", "Hujan Ringan", "Hujan Lebat"] },
        "wastewaterSource": { "type": "string" },
        "locationCode": { "type": "string" },
        "hasPhoto": { "type": "boolean" }
      },
      "required": ["id", "date", "location", "officer", "ph", "tss", "debit", "fe", "mn", "status"]
    },
    "WqLocation": {
      "title": "Water Quality Sampling Master Location",
      "description": "Master registry for KPL and settling pond outlets",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "name": { "type": "string" },
        "defaultSource": { "type": "string" },
        "docSuffix": { "type": "string" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "code", "name", "defaultSource", "isActive"]
    },
    "WastewaterPhoto": {
      "title": "Sampling Photo Evidence",
      "description": "Compressed field sampling photo evidence stored separately",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "wastewaterId": { "type": "string" },
        "dataUrl": { "type": "string" },
        "mimeType": { "type": "string", "enum": ["image/jpeg"] },
        "width": { "type": "number" },
        "height": { "type": "number" },
        "sizeBytes": { "type": "number" },
        "takenAt": { "type": "string" },
        "createdBy": { "type": "string" }
      },
      "required": ["id", "wastewaterId", "dataUrl", "mimeType", "width", "height", "sizeBytes", "takenAt", "createdBy"]
    },
    "EvidenceReport": {
      "title": "Evidence Report Document",
      "description": "Daily and monthly evidence report documents for wastewater compliance",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["daily"] },
        "documentNo": { "type": "string" },
        "revision": { "type": "number" },
        "period": { "type": "string" },
        "locationCode": { "type": "string" },
        "wastewaterId": { "type": "string" },
        "date": { "type": "string" },
        "status": { "type": "string", "enum": ["Draft", "Disiapkan", "Diperiksa", "Dibatalkan"] },
        "snapshot": { "type": "object" },
        "snapshotHash": { "type": "string" },
        "signatures": { "type": "object" },
        "verifyToken": { "type": "string" }
      },
      "required": ["id", "type", "period", "locationCode", "date", "status", "snapshot", "snapshotHash"]
    },
    "EvidenceVerification": {
      "title": "Public Evidence Verification",
      "description": "Minimal public verification payload for scanning QR Code",
      "type": "object",
      "properties": {
        "documentNo": { "type": "string" },
        "type": { "type": "string" },
        "period": { "type": "string" },
        "locationCode": { "type": "string" },
        "issuedAt": { "type": "string" },
        "status": { "type": "string" },
        "overall": { "type": "string" },
        "hashPrefix": { "type": "string" }
      },
      "required": ["documentNo", "type", "period", "locationCode", "issuedAt", "status", "overall", "hashPrefix"]
    },
    "UserSignature": {
      "title": "User Digital Signature",
      "description": "Stored digital signature PNG data URL for users",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "dataUrl": { "type": "string" }
      },
      "required": ["uid", "dataUrl"]
    },
    "Rainfall": {
      "title": "Rainfall Monitoring Entry",
      "description": "Daily precipitation logs at various mining telemetry stations",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "duration": { "type": "number" },
        "station": { "type": "string" },
        "gaugeType": { "type": "string", "enum": ["Manual", "Automatic"] },
        "rainfall": { "type": "number" },
        "intensity": { "type": "number" },
        "weather": { "type": "string", "enum": ["Clear", "Cloudy", "Light Rain", "Heavy Rain", "Storm"] },
        "notes": { "type": "string" }
      },
      "required": ["id", "date", "startTime", "endTime", "duration", "station", "gaugeType", "rainfall", "intensity", "weather"]
    },
    "Nursery": {
      "title": "Nursery Seedling Progress",
      "description": "Revegetation seedling inventory tracker",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "plantType": { "type": "string" },
        "quantity": { "type": "number" },
        "source": { "type": "string" },
        "ageWeeks": { "type": "number" },
        "heightCm": { "type": "number" },
        "status": { "type": "string", "enum": ["Healthy", "Need Care", "Critical"] },
        "location": { "type": "string" },
        "dateIn": { "type": "string", "format": "date" }
      },
      "required": ["id", "plantType", "quantity", "source", "ageWeeks", "heightCm", "status", "location", "dateIn"]
    },
    "ReclamationPlan": {
      "title": "Reclamation Block Target",
      "description": "Mine block restoration targets and species lists",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "areaName": { "type": "string" },
        "sizeHa": { "type": "number" },
        "targetYear": { "type": "number" },
        "plantType": { "type": "string" },
        "method": { "type": "string" },
        "estimatedCost": { "type": "number" },
        "status": { "type": "string", "enum": ["Draft", "Approved", "In Progress", "Completed"] },
        "pic": { "type": "string" }
      },
      "required": ["id", "areaName", "sizeHa", "targetYear", "plantType", "method", "estimatedCost", "status", "pic"]
    },
    "ReclamationGuarantee": {
      "title": "Reclamation Bond Guarantee",
      "description": "Financial guarantees submitted to authorities",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "guaranteeNo": { "type": "string" },
        "guaranteeType": { "type": "string", "enum": ["Bank Guarantee", "Time Deposit", "Environmental Bond"] },
        "value": { "type": "number" },
        "issuingInstitution": { "type": "string" },
        "issuedDate": { "type": "string", "format": "date" },
        "dueDate": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["Active", "Renewal Needed", "Claimed", "Released"] },
        "docUrl": { "type": "string" }
      },
      "required": ["id", "guaranteeNo", "guaranteeType", "value", "issuingInstitution", "issuedDate", "dueDate", "status"]
    },
    "WasteIn": {
      "title": "TPS B3 Intake Log",
      "description": "Hazardous B3 waste entrance recording",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "dateIn": { "type": "string", "format": "date" },
        "wasteType": { "type": "string" },
        "source": { "type": "string" },
        "weightKg": { "type": "number" },
        "characteristic": { "type": "string", "enum": ["Flammable", "Toxic", "Corrosive", "Reactive", "Infectious"] },
        "code": { "type": "string" },
        "tpsLocation": { "type": "string" },
        "officer": { "type": "string" },
        "documentationUrl": { "type": "string" }
      },
      "required": ["id", "dateIn", "wasteType", "source", "weightKg", "characteristic", "code", "tpsLocation", "officer"]
    },
    "WasteOut": {
      "title": "TPS B3 Dispatch Log",
      "description": "Hazardous B3 waste transportation and manifest recording",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "dateOut": { "type": "string", "format": "date" },
        "wasteType": { "type": "string" },
        "weightKg": { "type": "number" },
        "destination": { "type": "string" },
        "transporter": { "type": "string" },
        "manifestNo": { "type": "string" },
        "vehicleNo": { "type": "string" },
        "driverName": { "type": "string" },
        "recipient": { "type": "string" },
        "documentationUrl": { "type": "string" }
      },
      "required": ["id", "dateOut", "wasteType", "weightKg", "destination", "transporter", "manifestNo", "vehicleNo", "driverName", "recipient"]
    },
    "EnvironmentalDocument": {
      "title": "Environmental Permit compliance",
      "description": "Licensing documents: AMDAL, UKL/UPL, and sector permits",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["AMDAL", "UKL-UPL", "Izin Lingkungan", "Izin TPS B3", "Izin Pembuangan Air Limbah", "Persetujuan Rencana Reklamasi", "Persetujuan Pasca Tambang"] },
        "docNo": { "type": "string" },
        "issuedDate": { "type": "string", "format": "date" },
        "expiryDate": { "type": "string" },
        "status": { "type": "string", "enum": ["Active", "Expired", "Renewal Needed"] },
        "pic": { "type": "string" },
        "fileSize": { "type": "string" }
      },
      "required": ["id", "name", "type", "docNo", "issuedDate", "expiryDate", "status", "pic"]
    },
    "ComplianceEvent": {
      "title": "Licensing Calendar Event",
      "description": "Deadlines, reporting cycles, and inspections",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "title": { "type": "string" },
        "type": { "type": "string", "enum": ["Reporting", "Inspection", "Exceedance", "Permit Expiry"] },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["Pending", "Completed", "Overdue"] }
      },
      "required": ["id", "date", "title", "type", "description", "status"]
    },
    "Alert": {
      "title": "System Alert Notice",
      "description": "Real-time exceedance alerts or expiration notifications",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "type": { "type": "string", "enum": ["Critical", "Warning", "Info"] },
        "category": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "read": { "type": "boolean" }
      },
      "required": ["id", "timestamp", "type", "category", "title", "message", "read"]
    },
    "EnvironmentalCost": {
      "title": "Environmental Budget Cost",
      "description": "Opex and Capex planning and realization mapping for reclamation and monitoring programs",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "year": { "type": "number" },
        "period": { "type": "string" },
        "category": { "type": "string" },
        "plannedOpex": { "type": "number" },
        "plannedCapex": { "type": "number" },
        "realizedOpex": { "type": "number" },
        "realizedCapex": { "type": "number" },
        "notes": { "type": "string" },
        "officer": { "type": "string" }
      },
      "required": ["id", "year", "period", "category", "plannedOpex", "plannedCapex", "realizedOpex", "realizedCapex", "officer"]
    },
    "AuditLog": {
      "title": "Database Mutation Audit Trail",
      "description": "Automated logs monitoring data modification, insertion, and deletion",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string" },
        "user": { "type": "string" },
        "collection": { "type": "string" },
        "recordId": { "type": "string" },
        "action": { "type": "string" },
        "details": { "type": "string" }
      },
      "required": ["id", "timestamp", "user", "collection", "recordId", "action", "details"]
    },
    "SolidWaste": {
      "title": "Solid Waste Processing Entry",
      "description": "Solid waste sorting and reduction tracking under Permen LH No 7 Tahun 2025",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "source": { "type": "string" },
        "organicKg": { "type": "number" },
        "inorganicKg": { "type": "number" },
        "residueKg": { "type": "number" },
        "compostedKg": { "type": "number" },
        "recycledKg": { "type": "number" },
        "officer": { "type": "string" },
        "transporterVehicle": { "type": "string" },
        "finalDestination": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["id", "date", "source", "organicKg", "inorganicKg", "residueKg", "compostedKg", "recycledKg", "officer"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User profile definitions"
    },
    "solid_waste/{wasteId}": {
      "schema": "SolidWaste",
      "description": "Solid waste generation, composting, and recycling log entries"
    },
    "wastewater/{wastewaterId}": {
      "schema": "Wastewater",
      "description": "Wastewater quality log entries"
    },
    "rainfall/{rainfallId}": {
      "schema": "Rainfall",
      "description": "Mine telemetry rainfall entries"
    },
    "nursery/{nurseryId}": {
      "schema": "Nursery",
      "description": "Plant nursery stock inventory records"
    },
    "reclamation/{docId}": {
      "schema": "ReclamationPlan || ReclamationGuarantee",
      "description": "Mining blocks recovery schedules and financial guarantee bonds"
    },
    "waste_b3/{docId}": {
      "schema": "WasteIn || WasteOut",
      "description": "TPS B3 inbound, outbound manifest log entries"
    },
    "documents/{docId}": {
      "schema": "EnvironmentalDocument || ComplianceEvent",
      "description": "Authorized compliance permits and license calendar timelines"
    },
    "costs/{costId}": {
      "schema": "EnvironmentalCost",
      "description": "Mine recovery program budget logs"
    },
    "notifications/{alertId}": {
      "schema": "Alert",
      "description": "System notices and compliance trigger warnings"
    },
    "audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "Security audit trails"
    },
    "evidence_reports/{id}": {
      "schema": "EvidenceReport",
      "description": "Official daily and monthly environmental evidence documents"
    },
    "counters/{id}": {
      "schema": "object",
      "description": "Atomic sequential numbering counters for evidence documents"
    },
    "signatures/{uid}": {
      "schema": "UserSignature",
      "description": "User digital signature image data"
    },
    "evidence_verify/{token}": {
      "schema": "EvidenceVerification",
      "description": "Public verification payload for QR code validation"
    }
  }
}
