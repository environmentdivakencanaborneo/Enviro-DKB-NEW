        && d.inflowPh is number && d.inflowPh >= 0 && d.inflowPh <= 14
        && d.outflowPh is number && d.outflowPh >= 0 && d.outflowPh <= 14
        && d.inflowDebitM3s is number && d.inflowDebitM3s >= 0
        && d.outflowDebitM3s is number && d.outflowDebitM3s >= 0
        && d.limeKg is number && d.limeKg >= 0
