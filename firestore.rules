    // --- COLLECTION MATCHES ---

    // --- COLLECTION: users [SR-02, SR-03] ---
    match /users/{userId} {
      // [SR-03] Read dibatasi hanya akun bersangkutan atau Administrator
      allow read: if isVerifiedUser() && (request.auth.uid == userId || isAdmin());
      // [SR-02] Create diizinkan untuk registrasi akun baru pengguna sendiri (Viewer & Pending)
      allow create: if isVerifiedUser() && request.auth.uid == userId
        && (!('role' in request.resource.data) || request.resource.data.role == 'Viewer')
        && (!('isApproved' in request.resource.data) || request.resource.data.isApproved == false);
      allow update: if isVerifiedUser() && (
        isAdmin() || 
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isApproved', 'status', 'approvedBy', 'approvedAt']))
      );
      allow delete: if isAdmin();
    }
    
    // --- COLLECTION: roles ---
    match /roles/{email} {
      allow read: if isVerifiedUser();
      allow create, update, delete: if isAdmin();
    }

    // --- COLLECTION: audit_logs (IMMUTABLE APPEND-ONLY) [SR-01] ---
    match /audit_logs/{logId} {
      allow read: if isVerifiedUser();
      allow create: if isVerifiedUser() && vAuditLog();
      allow update: if false; // IMMUTABLE: Update ditolak permanen
      allow delete: if false; // IMMUTABLE: Delete ditolak permanen
    }

    // --- COLLECTION: app_meta ---
    match /app_meta/{metaId} {
      allow read: if isVerifiedUser();
      allow write: if isAdmin() || (isActiveMember() && isSuperintendent() && metaId in ['env_thresholds', 'proper_criteria']);
    }

    // --- COLLECTION: standards (Master Baku Mutu Lingkungan Dinamis) ---
    match /standards/{docId} {
      allow read: if isVerifiedUser();
      allow create, update: if isActiveMember() && isSuperintendent() && vEnvironmentalStandard();
      allow delete: if isAdmin();
    }

    // --- DOMAIN DATA COLLECTIONS ---
    
    // Compliance Matrix
    match /compliance_matrix/{matrixId} {
      allow read: if isVerifiedUser();
      allow create, update: if isActiveMember() && isOperator() && vComplianceMatrix();
      allow delete: if isAdmin() || isSuperintendent();
    }
    
    // Regulatory Watch
    match /regulatory/{regId} {
      allow read: if isVerifiedUser();
      allow create, update: if isActiveMember() && isSuperintendent() && vRegulatory();
      allow delete: if isAdmin();
    }
    
    // Incidents
    match /incidents/{incidentId} {
      allow read: if isVerifiedUser();
      allow create, update: if isActiveMember() && isOperator() && vIncident();
      allow delete: if isAdmin() || isSuperintendent();
    }
    
    // CAPA Findings
    match /capa/{capaId} {
      allow read: if isVerifiedUser();
      allow create, update: if isActiveMember() && isOperator() && vCapa();
      allow delete: if isAdmin() || isSuperintendent();
    }

    // [SR-04] Notifications & Alerts
    match /notifications/{notifId} {
      allow read: if isVerifiedUser();
      allow create, update: if isActiveMember() && vNotification();
      allow delete: if isActiveMember() && isSuperintendent();
    }

    match /alerts/{docId} {
      allow read: if isVerifiedUser();
      allow create, update: if isActiveMember() && vNotification();
      allow delete: if isActiveMember() && isSuperintendent();
    }
    
    // Master Titik Sampling Air Limbah (Wewenang Superintendent ke atas)
    match /wq_locations/{id} {
      allow read: if isActiveMember();
      allow create, update: if isSuperintendent();
      allow delete: if false;
    }

    // Foto Sampling Air Limbah (Evidence visual terpisah)
    match /wastewater_photos/{id} {
      allow read: if isActiveMember();
      allow create, update: if isActiveMember() && isOperator() 
        && request.resource.data.dataUrl is string 
        && request.resource.data.dataUrl.size() <= 400000 
        && request.resource.data.mimeType == 'image/jpeg';
      allow delete: if isSuperintendent();
    }

    // Evidence Reports (Dokumen Evidence Harian & Rekap Bulanan)
    match /evidence_reports/{id} {
      allow read: if isActiveMember();
      allow create: if isActiveMember() && isOperator();
      allow update: if isActiveMember() && isOperator() && (
        // Draft edit
        (resource.data.status == 'Draft') ||
        // Status transition from Draft to Disiapkan
        (resource.data.status == 'Draft' && request.resource.data.status == 'Disiapkan') ||
        // Reviewed signature update by Foreman or higher, email != prepared.email
        (request.resource.data.status == 'Diperiksa' && isForeman() && request.resource.data.signatures.reviewed.email != resource.data.signatures.prepared.email && request.resource.data.snapshotHash == resource.data.snapshotHash) ||
        // Approved signature update by Admin/Manager, email != prepared.email and email != reviewed.email
        (request.resource.data.status == 'Disetujui' && isAdmin() && request.resource.data.signatures.approved.email != resource.data.signatures.prepared.email && request.resource.data.signatures.approved.email != resource.data.signatures.reviewed.email && request.resource.data.snapshotHash == resource.data.snapshotHash) ||
        // Superintendent revision update: revision number incremented
        (isSuperintendent() && request.resource.data.revision > resource.data.revision) ||
        // Admin cancellation:
        (isAdmin() && request.resource.data.status == 'Dibatalkan')
      );
      allow delete: if isAdmin() && resource.data.status == 'Draft';
    }

    // Counters (Atomic sequential numbering FR-EMS-WQ-YYYY-xxxxx)
    match /counters/{id} {
      allow read: if isActiveMember();
      allow create: if isActiveMember() && isOperator() && request.resource.data.value == 1;
      allow update: if isActiveMember() && isOperator() && request.resource.data.value == resource.data.value + 1;
      allow delete: if false;
    }

    // User Signatures (Tanda Tangan Digital Pengguna)
    match /signatures/{uid} {
      allow read: if isActiveMember();
      allow create, update: if request.auth.uid == uid && isActiveMember() 
        && request.resource.data.dataUrl is string 
        && request.resource.data.dataUrl.size() <= 80000;
      allow delete: if false;
    }

    // Public Verification Documents (Minimal data untuk scan QR Code tanpa login) [HIGH-03]
    match /evidence_verify/{token} {
      allow get: if true;
      allow list: if false;
      allow create: if isActiveMember() && isOperator() && vEvidenceVerify() && request.resource.data.status == 'Disiapkan';
      allow update: if isActiveMember() && vEvidenceVerify() && (
        (request.resource.data.status == 'Disiapkan' && isSuperintendent()) ||
        (request.resource.data.status == 'Diperiksa' && isForeman()) ||
        (request.resource.data.status == 'Disetujui' && isAdmin()) ||
        (request.resource.data.status == 'Dibatalkan' && isAdmin())
      );
      allow delete: if false;
    }
    
    // Environmental Monitoring Collections [SR-05]
    match /wastewater/{docId} {
      allow read: if isActiveMember() || isVerifiedUser();
      allow create, update: if isActiveMember() && isOperator() && vWastewater();
      allow delete: if isAdmin() || isSuperintendent();
    }
    
    match /surfacewater/{docId} {
      allow read: if isVerifiedUser();
      allow create, update: if isActiveMember() && isOperator() && vSurfaceWater();
      allow delete: if isAdmin() || isSuperintendent();
    }
    
    match /rainfall/{docId} {
      allow read: if isVerifiedUser();
      allow create, update: if isActiveMember() && isOperator() && vRainfall();
      allow delete: if isAdmin() || isSuperintendent();
    }
    
    match /nursery_stock_out/{docId} {
      allow read: if isVerifiedUser();
      allow create, update: if isActiveMember() && isOperator() && vNurseryStockOut();
      allow delete: if isAdmin() || isSuperintendent();
    }

    match /nursery/{docId} {
      allow read: if isVerifiedUser();
      allow create, update: if isActiveMember() && isOperator() && vNursery();
      allow delete: if isAdmin() || isSuperintendent();
    }
    
    match /solid_waste/{docId} {
      allow read: if isVerifiedUser();
      allow create, update: if isActiveMember() && isOperator() && vSolidWaste();
      allow delete: if isAdmin() || isSuperintendent();
    }
    
    // [SR-05] /reclamation/{docId}: prefix 'RP-' -> vReclamationPlan(), 'RG-' -> vReclamationGuarantee()
    match /reclamation/{docId} {
      allow read: if isVerifiedUser();
      allow create, update: if isActiveMember() && isOperator() && (
        (docId.matches('^RP-.*') && vReclamationPlan()) ||
        (docId.matches('^RG-.*') && vReclamationGuarantee())
      );
      allow delete: if isAdmin() || isSuperintendent();
    }
    
    // [SR-05] /waste_b3/{docId}: prefix 'WI-' -> vWasteIn(), 'WO-' -> vWasteOut()
    match /waste_b3/{docId} {
      allow read: if isVerifiedUser();
      allow create, update: if isActiveMember() && isOperator() && (
        (docId.matches('^WI-.*') && vWasteIn()) ||
        (docId.matches('^WO-.*') && vWasteOut())
      );
      allow delete: if isAdmin() || isSuperintendent();
    }
    
    match /documents/{docId} {
      allow read: if isVerifiedUser();
      allow create, update: if isActiveMember() && (
        (docId.matches('^DOC-.*') && isSuperintendent() && vEnvDocument()) ||
        (docId.matches('^EV-.*') && isOperator() && vComplianceEvent())
      );
      allow delete: if isAdmin() || (docId.matches('^EV-.*') && isSuperintendent());
    }
    
    match /costs/{docId} {
      allow read: if isVerifiedUser();
      allow create, update: if isActiveMember() && isSuperintendent() && vCost();
      allow delete: if isAdmin();
    }

    match /amd_treatment/{docId} {
      allow read: if isVerifiedUser();
      allow create, update: if isActiveMember() && isOperator() && vAmdTreatment();
      allow delete: if isAdmin() || isSuperintendent();
    }

    match /air_emission/{docId} {
      allow read: if isVerifiedUser();
      allow create, update: if isActiveMember() && isOperator() && vAirEmission();
      allow delete: if isAdmin() || isSuperintendent();
    }

    match /topsoil_erosion/{docId} {
      allow read: if isVerifiedUser();
      allow create, update: if isActiveMember() && isOperator() && vTopsoilErosion();
      allow delete: if isAdmin() || isSuperintendent();
    }

    match /biodiversity/{docId} {
      allow read: if isVerifiedUser();
      allow create, update: if isActiveMember() && isOperator() && vBiodiversity();
      allow delete: if isAdmin() || isSuperintendent();
    }

    match /iadl_risk/{docId} {
      allow read: if isVerifiedUser();
      allow create, update: if isActiveMember() && isOperator() && vIadlRisk();
      allow delete: if isAdmin() || isSuperintendent();
    }

    match /proper_rkab/{docId} {
      allow read: if isVerifiedUser();
      allow create, update: if isActiveMember() && isSuperintendent() && vProperRkab();
      allow delete: if isAdmin() || isSuperintendent();
    }

    match /pertek_slo/{docId} {
      allow read: if isVerifiedUser();
      allow create, update: if isActiveMember() && isOperator() && vPertekSlo();
      allow delete: if isAdmin() || isSuperintendent();
    }

    match /reporting_calendar/{docId} {
      allow read: if isVerifiedUser();
      allow create, update: if isActiveMember() && isOperator() && vReportingCalendar();
      allow delete: if isAdmin() || isSuperintendent();
    }

    match /external_supervisions/{docId} {
      allow read: if isVerifiedUser();
      allow create, update: if isActiveMember() && isOperator() && vExternalSupervision();
      allow delete: if isAdmin() || isSuperintendent();
    }

    match /domestic_wastewater/{docId} {
      allow read: if isVerifiedUser();
      allow create, update: if isActiveMember() && isOperator() && vDomesticWastewater();
      allow delete: if isAdmin() || isSuperintendent();
    }

    match /ghg_factors/{docId} {
      allow read: if isVerifiedUser();
      allow create, update: if isActiveMember() && isOperator() && vGhgFactor();
      allow delete: if isAdmin() || isSuperintendent();
    }

    match /ghg_activities/{docId} {
      allow read: if isVerifiedUser();
      allow create, update: if isActiveMember() && isOperator() && vGhgActivity();
      allow delete: if isAdmin() || isSuperintendent();
    }

    match /forestry_ppkh/{docId} {
      allow read: if isVerifiedUser();
      allow create, update: if isActiveMember() && isOperator() && vForestryPpkh();
      allow delete: if isAdmin() || isSuperintendent();
    }
  }
}
