        && d.likelihoodScore is number && d.likelihoodScore >= 1 && d.likelihoodScore <= 5
        && d.riskScore is number && d.riskScore >= 1 && d.riskScore <= 25
        && d.riskLevel in ['Rendah', 'Sedang', 'Tinggi', 'Signifikan/Kritis']
        && isText(d.controlMeasure, 600)
        && isText(d.legalRef, 250)
