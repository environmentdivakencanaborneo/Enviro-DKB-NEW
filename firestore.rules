rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Is user authenticated
    function isVerifiedUser() {
      return request.auth != null;
    }
    
    // Helper: Get user role from Firestore
    function getUserRole() {
      let email = request.auth.token.email;
      let uid = request.auth.uid;
      
      return exists(/databases/$(database)/documents/roles/$(email))
        ? get(/databases/$(database)/documents/roles/$(email)).data.level
        : (exists(/databases/$(database)/documents/users/$(uid))
          ? get(/databases/$(database)/documents/users/$(uid)).data.role
          : 'Viewer');
    }

    function isAdmin() {
      let role = getUserRole();
      return role == 'Admin' || role == 'ADMIN' || role == 'admin' || role == 'Super Admin' || role == 'Env Manager';
    }

    function isSuperintendent() {
      let role = getUserRole();
      return isAdmin() || role == 'Superintendent' || role == 'SUPERINTENDENT' || role == 'superintendent' || role == 'Manager';
    }

    function isOperator() {
      let role = getUserRole();
      return isSuperintendent() || role == 'Operator' || role == 'OPERATOR' || role == 'operator' || role == 'Supervisor' || role == 'Foreman';
    }

    // --- COLLECTION: users ---
    match /users/{userId} {
      allow read: if isVerifiedUser();
      allow create: if isVerifiedUser() && request.auth.uid == userId;
      // Self-update without changing role OR Admin full update
      allow update: if isVerifiedUser() && (
        isAdmin() || 
        (request.auth.uid == userId && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])))
      );
      allow delete: if isAdmin();
    }
    
    // --- COLLECTION: roles ---
    match /roles/{email} {
      allow read: if isAdmin() || isSuperintendent();
      allow create, update, delete: if isAdmin();
    }

    // --- COLLECTION: audit_logs (IMMUTABLE APPEND-ONLY) ---
    match /audit_logs/{logId} {
      allow read: if isVerifiedUser();
      allow create: if isVerifiedUser();
      allow update: if false; // IMMUTABLE: Update denied
      allow delete: if false; // IMMUTABLE: Delete denied
    }

    // --- COLLECTION: app_meta ---
    match /app_meta/{metaId} {
      allow read: if isVerifiedUser();
      allow write: if isAdmin();
    }

    // --- DOMAIN DATA COLLECTIONS ---
    
    // Compliance Matrix
    match /compliance_matrix/{matrixId} {
      allow read: if isVerifiedUser();
      allow create, update: if isOperator();
      allow delete: if isAdmin() || isSuperintendent();
    }
    
    // Regulatory Watch
    match /regulatory/{regId} {
      allow read: if isVerifiedUser();
      allow create, update: if isSuperintendent();
      allow delete: if isAdmin();
    }
    
    // Incidents
    match /incidents/{incidentId} {
      allow read: if isVerifiedUser();
      allow create, update: if isOperator();
      allow delete: if isAdmin() || isSuperintendent();
    }
    
    // CAPA Findings
    match /capa/{capaId} {
      allow read: if isVerifiedUser();
      allow create, update: if isOperator();
      allow delete: if isAdmin() || isSuperintendent();
    }

    // Notifications
    match /notifications/{notifId} {
      allow read: if isVerifiedUser();
      allow create: if isVerifiedUser();
      allow update: if isOperator();
      allow delete: if isAdmin();
    }
    
    // Environmental Monitoring Collections
    match /wastewater/{docId} {
      allow read: if isVerifiedUser();
      allow create, update: if isOperator();
      allow delete: if isAdmin() || isSuperintendent();
    }
    
    match /surfacewater/{docId} {
      allow read: if isVerifiedUser();
      allow create, update: if isOperator();
      allow delete: if isAdmin() || isSuperintendent();
    }
    
    match /rainfall/{docId} {
      allow read: if isVerifiedUser();
      allow create, update: if isOperator();
      allow delete: if isAdmin() || isSuperintendent();
    }
    
    match /nursery/{docId} {
      allow read: if isVerifiedUser();
      allow create, update: if isOperator();
      allow delete: if isAdmin() || isSuperintendent();
    }
    
    match /solid_waste/{docId} {
      allow read: if isVerifiedUser();
      allow create, update: if isOperator();
      allow delete: if isAdmin() || isSuperintendent();
    }
    
    match /reclamation/{docId} {
      allow read: if isVerifiedUser();
      allow create, update: if isOperator();
      allow delete: if isAdmin() || isSuperintendent();
    }
    
    match /waste_b3/{docId} {
      allow read: if isVerifiedUser();
      allow create, update: if isOperator();
      allow delete: if isAdmin() || isSuperintendent();
    }
    
    match /documents/{docId} {
      allow read: if isVerifiedUser();
      allow create, update: if isSuperintendent();
      allow delete: if isAdmin();
    }
    
    match /costs/{docId} {
      allow read: if isVerifiedUser();
      allow create, update: if isSuperintendent();
      allow delete: if isAdmin();
    }
    
    match /alerts/{docId} {
      allow read: if isVerifiedUser();
      allow create, update: if isOperator();
      allow delete: if isAdmin();
    }
  }
}
