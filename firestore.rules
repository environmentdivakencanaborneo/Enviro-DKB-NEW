rules_version = '2';

// ============================================================================
// FIRESTORE SECURITY RULES - DEM (DIVA ENVIRO MONITOR)
// ============================================================================
//  Aplikasi : Diva Enviro Monitor (DEM) - Sistem Manajemen Lingkungan Tambang
//  Revisi   : 08 (Backend Tepercaya: Feature Flags app_meta/feature_flags,
//             Custom Claims K-03, Server Evaluation K-04, Server Evidence K-02,
//             Audit Trail Server Source)
//  Tanggal  : 2026
//  Fokus    : Hardened ABAC + Trusted Gen 2 Backend Feature-Flagged Gates
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Validasi batas jumlah max key dalam dokumen
    function shapeOk(maxKeys) {
      return request.resource.data.keys().size() <= maxKeys;
    }

    // Helper: Validasi format ID dokumen
    function isValidDocId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Helper: Validasi teks wajib & max len
    function isText(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    // Helper: Validasi teks opsional & max len
    function isOptText(val, maxLen) {
      return val == null || (val is string && val.size() <= maxLen);
    }

    // Helper: Is user authenticated AND email verified
    function isVerifiedUser() {
      return request.auth != null
        && request.auth.token != null
        && request.auth.token.email_verified == true;
    }

    // Helper: Check if user is strictly approved & active (AND condition)
    // Menolak Suspended, Disabled, Deleted, Rejected, Pending, atau Active tanpa isApproved == true
    function isApprovedUser() {
      let uid = request.auth.uid;
      let userDoc = get(/databases/$(database)/documents/users/$(uid)).data;
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(uid))
        && userDoc.get('isApproved', false) == true
        && userDoc.get('status', '') == 'Active'
        && !(userDoc.get('status', '') in ['Disabled', 'Deleted', 'Rejected', 'Suspended', 'Pending'])
        && userDoc.get('isActive', true) != false
        && userDoc.get('deleted', false) != true;
    }

    // Helper: Check if user is authenticated, email-verified, and strictly approved active member
    function isActiveMember() {
      return isVerifiedUser() && isApprovedUser();
    }

    // Helper: Feature Flags bertahap di app_meta/feature_flags (default false)
    function getFeatureFlags() {
      return exists(/databases/$(database)/documents/app_meta/feature_flags)
        ? get(/databases/$(database)/documents/app_meta/feature_flags).data
        : {};
    }

    function isServerEvaluationEnabled() {
      return getFeatureFlags().get('serverEvaluation', false) == true;
    }

    function isServerEvidenceEnabled() {
      return getFeatureFlags().get('serverEvidence', false) == true;
    }

    function isRoleClaimsEnabled() {
      return getFeatureFlags().get('roleClaims', false) == true;
    }

    // Helper: [K-03] Baca Custom Claims saat flag roleClaims aktif; fallback ke /roles/{email} atau 'Viewer'
    function getUserRole() {
      let hasEmail = request.auth.token != null && 'email' in request.auth.token && request.auth.token.email != null;
      let email = hasEmail ? request.auth.token.email : '';
      let hasClaimRole = isRoleClaimsEnabled()
        && request.auth.token != null
        && 'role' in request.auth.token
        && request.auth.token.role is string
        && request.auth.token.role.size() > 0;

      return hasClaimRole
        ? request.auth.token.role
        : ((hasEmail && exists(/databases/$(database)/documents/roles/$(email)))
          ? get(/databases/$(database)/documents/roles/$(email)).data.level
          : 'Viewer');
    }

    // Helper: [SR-07] Akses darurat (Break-Glass) untuk pemulihan kegagalan sistem.
    // Tetap dipagari oleh isActiveMember() pada rule koleksi.
    function isBreakGlassAdmin() {
      let hasEmail = request.auth.token != null && 'email' in request.auth.token && request.auth.token.email != null;
      let email = hasEmail ? request.auth.token.email : '';
      return email == 'environmentdivakencanaborneo@gmail.com'
        || email == 'admin@divaborneo.co.id';
    }

    // Helper: [SR-06] Sinkronisasi hirarki peran:
    // Admin & Environment Manager (Rank 5 & 4, termasuk alias 'Manager')
    function isAdmin() {
      let role = getUserRole();
      return isBreakGlassAdmin()
        || role in ['Admin', 'ADMIN', 'admin', 'Super Admin', 'Environment Manager', 'Env Manager', 'Manager'];
    }

    // Khusus pemegang hak Admin penuh (rank 5) atau break-glass
    function isStrictAdmin() {
      let role = getUserRole();
      return isBreakGlassAdmin()
        || role in ['Admin', 'ADMIN', 'admin', 'Super Admin'];
    }

    // [K-03] Khusus Environment Manager (rank 4) & daftar peran yang boleh ditetapkannya
    function isManager() {
      let role = getUserRole();
      return role in ['Environment Manager', 'Env Manager', 'Manager'];
    }

    function managerAssignableRoles() {
      return ['Viewer', 'Auditor', 'Operator', 'Foreman', 'Environment Superintendent'];
    }

    // [T-02] Helper peran Auditor eksplisit (read-only audit & data rahasia tertentu)
    function isAuditorRole() {
      return getUserRole() in ['Auditor', 'auditor'];
    }

    // Environment Superintendent (Rank 3)
    function isSuperintendent() {
      let role = getUserRole();
      return isAdmin()
        || role in ['Environment Superintendent', 'Superintendent', 'SUPERINTENDENT', 'superintendent'];
    }

    // Foreman / Pengawas Lapangan (Rank 2.5)
    function isForeman() {
      let role = getUserRole();
      return isSuperintendent()
        || role in ['Foreman', 'Supervisor'];
    }

    // Operator (Rank 2)
    function isOperator() {
      let role = getUserRole();
      return isForeman()
        || role in ['Operator', 'OPERATOR', 'operator'];
    }

    // Auditor (Rank 1)
    function isAuditor() {
      let role = getUserRole();
      return isOperator()
        || role in ['Auditor', 'auditor'];
    }

    // --- DOMAIN VALIDATORS ---

    // [SR-01] Structured Audit Log Schema Validator (Immutable Append-Only)
    function vAuditLog() {
      let d = request.resource.data;
      return d.keys().hasAll(['id', 'uid', 'timestamp', 'user', 'collection', 'recordId', 'action', 'details'])
        && d.keys().hasOnly([
          'id', 'uid', 'timestamp', 'user', 'actorName', 'actorRole', 'module',
          'collection', 'recordId', 'action', 'details',
          'beforeData', 'afterData', 'correctionReason', 'status', 'source'
        ])
        && d.get('source', 'client') == 'client'
        && d.uid == request.auth.uid
        && request.auth.token != null && 'email' in request.auth.token
        && d.user == request.auth.token.email
        && d.timestamp == request.time
        && d.action in ['insert', 'update', 'delete', 'sync', 'backup', 'restore', 'export', 'login', 'logout', 'approve', 'reject', 'role_change', 'correct']
        && isText(d.id, 128)
        && isText(d.collection, 64)
        && isText(d.recordId, 128)
        && isText(d.details, 1000)
        && isOptText(d.get('module', null), 64)
        && isOptText(d.get('actorName', null), 120)
        && isOptText(d.get('actorRole', null), 60)
        && isOptText(d.get('correctionReason', null), 400)
        && (d.get('beforeData', null) == null || d.beforeData is map)
        && (d.get('afterData', null) == null || d.afterData is map)
        && (d.get('status', null) == null || d.status in ['SUCCESS', 'FAILED']);
    }

    // [SR-04, SR-05, S-07] Notification & Alert Validator
    function vNotification(docId) {
      let d = request.resource.data;
      return d.keys().hasAll(['id', 'timestamp', 'type', 'category', 'title', 'message', 'read', 'createdBy'])
        && shapeOk(14)
        && d.id == docId
        && isValidDocId(d.id)
        && d.type in ['Critical', 'Warning', 'Info']
        && d.category in ['Wastewater', 'B3 Waste', 'Permit', 'Guarantee', 'SurfaceWater', 'Solid Waste', 'Air & Emission', 'AMD Treatment', 'Biodiversity', 'Incident']
        && isText(d.title, 200)
        && isText(d.message, 1000)
        && d.read is bool
        && isText(d.createdBy, 100)
        && (d.get('readBy', null) == null || d.readBy is list)
        && (d.get('clearedBy', null) == null || d.clearedBy is list);
    }

    // Wastewater Validator (5-state evaluationStatus + legacy fallback compat + T-07 nullable + K-04 serverEvaluation)
    function vWastewater(docId) {
      let d = request.resource.data;
      return d.keys().hasAll(['id','date','location','officer','ph','tss','debit','fe','mn'])
        && (isServerEvaluationEnabled() || 'status' in d)
        && shapeOk(38)
        && d.id == docId
        && isValidDocId(d.id)
        && isText(d.date, 20)
        && isText(d.location, 150)
        && isText(d.officer, 100)
        && (d.ph == null ? (d.get('missingReasons', null) is map && 'ph' in d.missingReasons) : (d.ph is number && d.ph >= 0 && d.ph <= 14))
        && (d.tss == null ? (d.get('missingReasons', null) is map && 'tss' in d.missingReasons) : (d.tss is number && d.tss >= 0))
        && (d.debit == null ? (d.get('missingReasons', null) is map && 'debit' in d.missingReasons) : (d.debit is number && d.debit >= 0))
        && (d.fe == null ? (d.get('missingReasons', null) is map && 'fe' in d.missingReasons) : (d.fe is number && d.fe >= 0))
        && (d.mn == null ? (d.get('missingReasons', null) is map && 'mn' in d.missingReasons) : (d.mn is number && d.mn >= 0))
        && (d.get('missingReasons', null) == null || d.missingReasons is map)
        && (d.get('evaluationHistory', null) == null || d.evaluationHistory is list)
        && (d.get('status', null) == null || d.status in ['Safe', 'Warning', 'Exceeded', 'Incomplete', 'Unevaluated', 'NotApplicable'])
        && (d.get('evaluationStatus', null) == null || d.evaluationStatus in ['MEMENUHI', 'TIDAK MEMENUHI', 'DATA TIDAK LENGKAP', 'BELUM DIEVALUASI', 'TIDAK BERLAKU'])
        && isOptText(d.get('evaluationReason', null), 1000)
        && (d.get('unitMap', null) == null || d.unitMap is map)
        && (d.get('monitoringType', null) == null || d.monitoringType in ['Harian', 'Bulanan'])
        && (d.get('sampleTime', null) == null || (d.sampleTime is string && d.sampleTime.size() == 5))
        && (d.get('weather', null) == null || d.weather in ['Cerah', 'Berawan', 'Hujan Ringan', 'Hujan Lebat'])
        && isOptText(d.get('wastewaterSource', null), 150)
        && isOptText(d.get('locationCode', null), 50)
        && (d.get('hasPhoto', null) == null || d.hasPhoto is bool)
        && isOptText(d.get('standardId', null), 128)
        && isOptText(d.get('standardBasis', null), 400)
        && (d.get('standardSnapshot', null) == null || d.standardSnapshot is map)
        && (d.get('serverEvaluatedAt', null) == null || d.serverEvaluatedAt is timestamp)
        && isOptText(d.get('correctionReason', null), 500)
        && isOptText(d.get('createdBy', null), 100)
        && isOptText(d.get('updatedBy', null), 100);
    }

    // [SR-05, S-07, T-07, K-04] Surface Water Validator
    function vSurfaceWater(docId) {
      let d = request.resource.data;
      return d.keys().hasAll(['id','date','location','officer','ph','tss','doVal','bod','cod','fe','mn'])
        && (isServerEvaluationEnabled() || 'status' in d)
        && shapeOk(36)
        && d.id == docId
        && isValidDocId(d.id)
        && isText(d.date, 50)
        && isText(d.location, 150)
        && isText(d.officer, 100)
        && (d.ph == null ? (d.get('missingReasons', null) is map && 'ph' in d.missingReasons) : (d.ph is number && d.ph >= 0 && d.ph <= 14))
        && (d.tss == null ? (d.get('missingReasons', null) is map && 'tss' in d.missingReasons) : (d.tss is number && d.tss >= 0))
        && (d.doVal == null ? (d.get('missingReasons', null) is map && 'doVal' in d.missingReasons) : (d.doVal is number && d.doVal >= 0))
        && (d.bod == null ? (d.get('missingReasons', null) is map && 'bod' in d.missingReasons) : (d.bod is number && d.bod >= 0))
        && (d.cod == null ? (d.get('missingReasons', null) is map && 'cod' in d.missingReasons) : (d.cod is number && d.cod >= 0))
        && (d.fe == null ? (d.get('missingReasons', null) is map && 'fe' in d.missingReasons) : (d.fe is number && d.fe >= 0))
        && (d.mn == null ? (d.get('missingReasons', null) is map && 'mn' in d.missingReasons) : (d.mn is number && d.mn >= 0))
        && (d.get('missingReasons', null) == null || d.missingReasons is map)
        && (d.get('evaluationHistory', null) == null || d.evaluationHistory is list)
        && (d.get('status', null) == null || d.status in ['Safe', 'Warning', 'Exceeded', 'Incomplete', 'Unevaluated', 'NotApplicable'])
        && (d.get('evaluationStatus', null) == null || d.evaluationStatus in ['MEMENUHI', 'TIDAK MEMENUHI', 'DATA TIDAK LENGKAP', 'BELUM DIEVALUASI', 'TIDAK BERLAKU'])
        && isOptText(d.get('evaluationReason', null), 1000)
        && (d.get('unitMap', null) == null || d.unitMap is map)
        && (d.get('monitoringType', null) == null || d.monitoringType in ['Harian', 'Bulanan'])
        && (d.get('kelasAir', null) == null || d.kelasAir in ['I', 'II', 'III', 'IV'])
        && isOptText(d.get('standardId', null), 128)
        && isOptText(d.get('standardBasis', null), 400)
        && (d.get('standardSnapshot', null) == null || d.standardSnapshot is map)
        && (d.get('serverEvaluatedAt', null) == null || d.serverEvaluatedAt is timestamp)
        && isOptText(d.get('correctionReason', null), 500)
        && isOptText(d.get('createdBy', null), 100)
        && isOptText(d.get('updatedBy', null), 100);
    }

    // [SR-05, S-07] Rainfall Validator
    function vRainfall(docId) {
      let d = request.resource.data;
      return d.keys().hasAll(['id','date','startTime','endTime','duration','station','gaugeType','rainfall','intensity','weather'])
        && shapeOk(16)
        && d.id == docId
        && isValidDocId(d.id)
        && isText(d.date, 50)
        && isText(d.startTime, 50)
        && isText(d.endTime, 50)
        && d.duration is number && d.duration >= 0
        && isText(d.station, 100)
        && d.gaugeType in ['Manual', 'Automatic']
        && d.rainfall is number && d.rainfall >= 0
        && d.intensity is number && d.intensity >= 0
        && d.weather in ['Clear', 'Cloudy', 'Light Rain', 'Heavy Rain', 'Storm']
        && isOptText(d.get('notes', null), 1000)
        && isOptText(d.get('createdBy', null), 100)
        && isOptText(d.get('updatedBy', null), 100);
    }

    // [SR-05, S-07] Nursery Validator
    function vNursery(docId) {
      let d = request.resource.data;
      return d.keys().hasAll(['id','plantType','quantity','source','ageWeeks','heightCm','status','location','dateIn'])
        && shapeOk(18)
        && d.id == docId
        && isValidDocId(d.id)
        && isText(d.plantType, 200)
        && d.quantity is number && d.quantity >= 0
        && isText(d.source, 200)
        && d.ageWeeks is number && d.ageWeeks >= 0
        && d.heightCm is number && d.heightCm >= 0
        && d.status in ['Healthy', 'Need Care', 'Critical', 'Sehat', 'Perlu Perawatan', 'Rusak']
        && isText(d.location, 200)
        && isText(d.dateIn, 50)
        && isOptText(d.get('batchCode', null), 100)
        && isOptText(d.get('seedDate', null), 50)
        && (d.get('minimumStock', null) == null || (d.minimumStock is number && d.minimumStock >= 0))
        && isOptText(d.get('createdBy', null), 100)
        && isOptText(d.get('updatedBy', null), 100);
    }

    // [SR-05, CRIT-02, S-07] Nursery Stock Out Validator
    function vNurseryStockOut(docId) {
      let d = request.resource.data;
      return d.keys().hasAll(['id','tanggal','jenisBibitId','namaBibit','species','jumlahKeluar','satuan','tujuan','lokasiPenanaman','luasReklamasi','penanggungJawab','createdBy','createdAt'])
        && shapeOk(25)
        && d.id == docId
        && isValidDocId(d.id)
        && isText(d.tanggal, 50)
        && isText(d.jenisBibitId, 128)
        && isText(d.namaBibit, 200)
        && isText(d.species, 200)
        && d.jumlahKeluar is number && d.jumlahKeluar >= 1
        && isText(d.satuan, 50)
        && isText(d.tujuan, 300)
        && isText(d.lokasiPenanaman, 300)
        && d.luasReklamasi is number && d.luasReklamasi >= 0
        && isText(d.penanggungJawab, 100)
        && isText(d.createdBy, 100)
        && (d.createdAt is timestamp || isText(d.createdAt, 100))
        && (d.get('updatedAt', null) == null || d.updatedAt is timestamp || isText(d.updatedAt, 100))
        && isOptText(d.get('nomorTransaksi', null), 100)
        && isOptText(d.get('batchCode', null), 100)
        && (d.get('jenisTransaksi', null) == null || d.jenisTransaksi in ['Penanaman', 'Penggantian Tanaman Mati', 'Distribusi', 'Mutasi', 'Rusak', 'Lainnya'])
        && isOptText(d.get('kapling', null), 100)
        && isOptText(d.get('blok', null), 100)
        && isOptText(d.get('pit', null), 100)
        && isOptText(d.get('keterangan', null), 1000)
        && isOptText(d.get('updatedBy', null), 100);
    }

    // [SR-05, S-07] Reclamation Plan Validator (Prefix 'RP-')
    function vReclamationPlan(docId) {
      let d = request.resource.data;
      return d.keys().hasAll(['id','areaName','sizeHa','targetYear','plantType','method','estimatedCost','status','pic'])
        && shapeOk(22)
        && d.id == docId
        && isValidDocId(d.id)
        && isText(d.areaName, 200)
        && d.sizeHa is number && d.sizeHa >= 0
        && (d.get('realizedSizeHa', null) == null || (d.realizedSizeHa is number && d.realizedSizeHa >= 0))
        && d.targetYear is number && d.targetYear >= 2000 && d.targetYear <= 2100
        && (d.get('realizedYear', null) == null || (d.realizedYear is number && d.realizedYear >= 2000 && d.realizedYear <= 2100))
        && isText(d.plantType, 200)
        && isOptText(d.get('realizedPlantType', null), 200)
        && isText(d.method, 200)
        && isOptText(d.get('realizedMethod', null), 200)
        && d.estimatedCost is number && d.estimatedCost >= 0
        && (d.get('realizedCost', null) == null || (d.realizedCost is number && d.realizedCost >= 0))
        && d.status in ['Draft', 'Approved', 'In Progress', 'Completed']
        && isText(d.pic, 100)
        && isOptText(d.get('createdBy', null), 100)
        && isOptText(d.get('updatedBy', null), 100);
    }

    // [SR-05, S-07] Reclamation Guarantee Validator (Prefix 'RG-')
    function vReclamationGuarantee(docId) {
      let d = request.resource.data;
      return d.keys().hasAll(['id','guaranteeNo','guaranteeType','value','issuingInstitution','issuedDate','dueDate','status'])
        && shapeOk(22)
        && d.id == docId
        && isValidDocId(d.id)
        && isText(d.guaranteeNo, 100)
        && (d.get('periodYear', null) == null || (d.periodYear is number && d.periodYear >= 2000 && d.periodYear <= 2100))
        && d.guaranteeType in ['Bank Guarantee', 'Time Deposit', 'Environmental Bond']
        && (d.get('bankType', null) == null || d.bankType in ['Bank Pemerintah', 'Lainnya'])
        && (d.get('guaranteeCategory', null) == null || d.guaranteeCategory in ['Jaminan Reklamasi', 'Jaminan Pascatambang'])
        && d.value is number && d.value >= 0
        && isText(d.issuingInstitution, 200)
        && isText(d.issuedDate, 50)
        && isText(d.dueDate, 50)
        && d.status in ['Active', 'Renewal Needed', 'Claimed', 'Released']
        && isOptText(d.get('docUrl', null), 2000)
        && isOptText(d.get('createdBy', null), 100)
        && isOptText(d.get('updatedBy', null), 100);
    }

    // [SR-05, S-07] Hazardous Waste In Validator (Prefix 'WI-')
    function vWasteIn(docId) {
      let d = request.resource.data;
      return d.keys().hasAll(['id','dateIn','wasteType','source','weightKg','characteristic','code','tpsLocation','officer'])
        && shapeOk(22)
        && d.id == docId
        && isValidDocId(d.id)
        && isText(d.dateIn, 50)
        && isText(d.wasteType, 200)
        && isText(d.source, 200)
        && d.weightKg is number && d.weightKg > 0
        && d.characteristic in ['Flammable', 'Toxic', 'Corrosive', 'Reactive', 'Infectious']
        && isText(d.code, 50)
        && isText(d.tpsLocation, 100)
        && isText(d.officer, 100)
        && isOptText(d.get('documentationUrl', null), 2000)
        && isOptText(d.get('correctionReason', null), 500)
        && isOptText(d.get('createdBy', null), 100)
        && isOptText(d.get('updatedBy', null), 100);
    }

    // [SR-05, S-07] Hazardous Waste Out Validator (Prefix 'WO-')
    function vWasteOut(docId) {
      let d = request.resource.data;
      return d.keys().hasAll(['id','dateOut','wasteType','weightKg','destination','transporter','manifestNo','vehicleNo','driverName','recipient'])
        && shapeOk(22)
        && d.id == docId
        && isValidDocId(d.id)
        && isText(d.dateOut, 50)
        && isText(d.wasteType, 200)
        && d.weightKg is number && d.weightKg > 0
        && isText(d.destination, 200)
        && isText(d.transporter, 200)
        && isText(d.manifestNo, 100)
        && isText(d.vehicleNo, 50)
        && isText(d.driverName, 100)
        && isText(d.recipient, 100)
        && isOptText(d.get('documentationUrl', null), 2000)
        && isOptText(d.get('correctionReason', null), 500)
        && isOptText(d.get('createdBy', null), 100)
        && isOptText(d.get('updatedBy', null), 100);
    }

    // [SR-05, S-07] Solid Waste Validator
    function vSolidWaste(docId) {
      let d = request.resource.data;
      return d.keys().hasAll(['id','date','source','organicKg','inorganicKg','residueKg','compostedKg','recycledKg','officer'])
        && shapeOk(17)
        && d.id == docId
        && isValidDocId(d.id)
        && isText(d.date, 50)
        && isText(d.source, 150)
        && d.organicKg is number && d.organicKg >= 0
        && d.inorganicKg is number && d.inorganicKg >= 0
        && d.residueKg is number && d.residueKg >= 0
        && d.compostedKg is number && d.compostedKg >= 0
        && d.recycledKg is number && d.recycledKg >= 0
        && isText(d.officer, 100)
        && isOptText(d.get('transporterVehicle', null), 100)
        && isOptText(d.get('finalDestination', null), 200)
        && isOptText(d.get('notes', null), 1000)
        && isOptText(d.get('createdBy', null), 100)
        && isOptText(d.get('updatedBy', null), 100);
    }

    // [SR-05, S-07] Environmental Cost Validator
    function vCost(docId) {
      let d = request.resource.data;
      return d.keys().hasAll(['id','year','period','category','plannedOpex','plannedCapex','realizedOpex','realizedCapex','officer'])
        && shapeOk(18)
        && d.id == docId
        && isValidDocId(d.id)
        && isOptText(d.get('budgetCode', null), 80)
        && d.year is number && d.year >= 2000 && d.year <= 2100
        && isText(d.period, 50)
        && isText(d.category, 100)
        && d.plannedOpex is number && d.plannedOpex >= 0
        && d.plannedCapex is number && d.plannedCapex >= 0
        && d.realizedOpex is number && d.realizedOpex >= 0
        && d.realizedCapex is number && d.realizedCapex >= 0
        && isText(d.officer, 100)
