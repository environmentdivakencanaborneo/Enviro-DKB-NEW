rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Is user authenticated
    function isVerifiedUser() {
      return request.auth != null;
    }

    // Helper: Check if user is approved & active
    function isApprovedUser() {
      let uid = request.auth.uid;
      return request.auth != null && (
        !exists(/databases/$(database)/documents/users/$(uid)) ||
        get(/databases/$(database)/documents/users/$(uid)).data.isApproved == true ||
        get(/databases/$(database)/documents/users/$(uid)).data.status == 'Active'
      );
    }
    
    // Helper: Get user role from Firestore
    function getUserRole() {
      let uid = request.auth.uid;
      let hasEmail = request.auth.token != null && 'email' in request.auth.token && request.auth.token.email != null;
      let email = hasEmail ? request.auth.token.email : '';
      
      return (hasEmail && exists(/databases/$(database)/documents/roles/$(email)))
        ? get(/databases/$(database)/documents/roles/$(email)).data.level
        : (exists(/databases/$(database)/documents/users/$(uid))
          ? get(/databases/$(database)/documents/users/$(uid)).data.role
          : 'Viewer');
    }

    function isAdmin() {
      let role = getUserRole();
      let hasEmail = request.auth.token != null && 'email' in request.auth.token && request.auth.token.email != null;
      let email = hasEmail ? request.auth.token.email : '';
      return role == 'Admin' || role == 'ADMIN' || role == 'admin' || role == 'Super Admin' || role == 'Env Manager' || role == 'Environment Manager'
        || email == 'environmentdivakencanaborneo@gmail.com'
        || email == 'admin@divaborneo.co.id';
    }

    function isSuperintendent() {
      let role = getUserRole();
      return isAdmin() || role == 'Superintendent' || role == 'SUPERINTENDENT' || role == 'superintendent' || role == 'Manager' || role == 'Environment Superintendent';
    }

    function isOperator() {
      let role = getUserRole();
      return isSuperintendent() || role == 'Operator' || role == 'OPERATOR' || role == 'operator' || role == 'Supervisor' || role == 'Foreman';
    }

    // --- COLLECTION: users ---
    match /users/{userId} {
      allow read: if isVerifiedUser();
      allow create: if isVerifiedUser() && request.auth.uid == userId;
      allow update: if isVerifiedUser() && (
        isAdmin() || 
        request.auth.uid == userId
      );
      allow delete: if isAdmin();
    }
    
    // --- COLLECTION: roles ---
    match /roles/{email} {
      allow read: if isVerifiedUser();
      allow create, update, delete: if isAdmin();
    }

    // --- COLLECTION: audit_logs (IMMUTABLE APPEND-ONLY) ---
    match /audit_logs/{logId} {
      allow read: if isVerifiedUser();
      allow create: if isVerifiedUser();
      allow update: if false; // IMMUTABLE: Update denied
      allow delete: if false; // IMMUTABLE: Delete denied
    }

    // --- COLLECTION: app_meta ---
    match /app_meta/{metaId} {
      allow read: if isVerifiedUser();
      allow write: if isAdmin();
    }

    // --- DOMAIN DATA COLLECTIONS ---
    
    // Compliance Matrix
    match /compliance_matrix/{matrixId} {
      allow read: if isVerifiedUser();
      allow create, update: if isOperator() || isVerifiedUser();
      allow delete: if isAdmin() || isSuperintendent();
    }
    
    // Regulatory Watch
    match /regulatory/{regId} {
      allow read: if isVerifiedUser();
      allow create, update: if isSuperintendent() || isVerifiedUser();
      allow delete: if isAdmin();
    }
    
    // Incidents
    match /incidents/{incidentId} {
      allow read: if isVerifiedUser();
      allow create, update: if isOperator() || isVerifiedUser();
      allow delete: if isAdmin() || isSuperintendent();
    }
    
    // CAPA Findings
    match /capa/{capaId} {
      allow read: if isVerifiedUser();
      allow create, update: if isOperator() || isVerifiedUser();
      allow delete: if isAdmin() || isSuperintendent();
    }

    // Notifications
    match /notifications/{notifId} {
      allow read: if isVerifiedUser();
      allow create: if isVerifiedUser();
      allow update: if isVerifiedUser();
      allow delete: if isVerifiedUser();
    }
    
    // Environmental Monitoring Collections
    match /wastewater/{docId} {
      allow read: if isVerifiedUser();
      allow create, update: if isOperator() || isVerifiedUser();
      allow delete: if isAdmin() || isSuperintendent();
    }
    
    match /surfacewater/{docId} {
      allow read: if isVerifiedUser();
      allow create, update: if isOperator() || isVerifiedUser();
      allow delete: if isAdmin() || isSuperintendent();
    }
    
    match /rainfall/{docId} {
      allow read: if isVerifiedUser();
      allow create, update: if isOperator() || isVerifiedUser();
      allow delete: if isAdmin() || isSuperintendent();
    }
    
    match /nursery/{docId} {
      allow read: if isVerifiedUser();
      allow create, update: if isOperator() || isVerifiedUser();
      allow delete: if isAdmin() || isSuperintendent();
    }
    
    match /solid_waste/{docId} {
      allow read: if isVerifiedUser();
      allow create, update: if isOperator() || isVerifiedUser();
      allow delete: if isAdmin() || isSuperintendent();
    }
    
    match /reclamation/{docId} {
      allow read: if isVerifiedUser();
      allow create, update: if isOperator() || isVerifiedUser();
      allow delete: if isAdmin() || isSuperintendent();
    }
    
    match /waste_b3/{docId} {
      allow read: if isVerifiedUser();
      allow create, update: if isOperator() || isVerifiedUser();
      allow delete: if isAdmin() || isSuperintendent();
    }
    
    match /documents/{docId} {
      allow read: if isVerifiedUser();
      allow create, update: if isSuperintendent() || isVerifiedUser();
      allow delete: if isAdmin();
    }
    
    match /costs/{docId} {
      allow read: if isVerifiedUser();
      allow create, update: if isSuperintendent() || isVerifiedUser();
      allow delete: if isAdmin();
    }
    
    match /alerts/{docId} {
      allow read: if isVerifiedUser();
      allow create, update: if isOperator() || isVerifiedUser();
      allow delete: if isAdmin();
    }
  }
}
