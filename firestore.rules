        && isText(d.unit, 40)
        && (d.get('minLimit', null) == null || d.minLimit is number)
        && (d.get('maxLimit', null) == null || d.maxLimit is number)
        && isText(d.basisRegulasi, 300)
        && isOptText(d.get('effectiveFrom', null), 30)
        && isOptText(d.get('locationCode', null), 50)
        && (d.get('kelasAir', null) == null || d.kelasAir in ['I', 'II', 'III', 'IV'])
        && d.isActive is bool
        && d.verificationStatus in ['Terverifikasi', 'Perlu verifikasi']
        && isOptText(d.get('notes', null), 1000)
