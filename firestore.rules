rules_version = '2';

// ============================================================================
// FIRESTORE SECURITY RULES - ENV-COAL PRO
// ============================================================================
//  Aplikasi : System Manajemen Lingkungan Pertambangan (ENV-COAL PRO)
//  Revisi   : 02a
//  Tanggal  : 2026
//  Fokus    : Hardened ABAC Security Rules with Field Validation
// ============================================================================
//  PERUBAHAN UTAMA:
//  1. Penambahan validator skema & batas ukuran field (shapeOk, isText, isOptText).
//  2. Penataan ulang RBAC berbasis per-koleksi.
//  8. Rev. 02a: koreksi vCapa (batas field), enum tipe dokumen, dan tiga batas shapeOk
//     hasil verifikasi silang terhadap src/types.ts dan src/utils/validation.ts.

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Validasi batas jumlah max key dalam dokumen
    function shapeOk(maxKeys) {
      return request.resource.data.keys().size() <= maxKeys;
    }

    // Helper: Validasi format ID dokumen
    function isValidDocId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Helper: Validasi teks wajib & max len
    function isText(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    // Helper: Validasi teks opsional & max len
    function isOptText(val, maxLen) {
      return val == null || (val is string && val.size() <= maxLen);
    }
    
    // Helper: Is user authenticated
    function isVerifiedUser() {
      return request.auth != null;
    }

    // Helper: Check if user is approved & active
    function isApprovedUser() {
      let uid = request.auth.uid;
      return request.auth != null && (
        !exists(/databases/$(database)/documents/users/$(uid)) ||
        get(/databases/$(database)/documents/users/$(uid)).data.isApproved == true ||
        get(/databases/$(database)/documents/users/$(uid)).data.status == 'Active'
      );
    }

    // Helper: Check if user is authenticated and approved member
    function isActiveMember() {
      return isVerifiedUser() && isApprovedUser();
    }
    
    // Helper: Get user role from Firestore
    function getUserRole() {
      let uid = request.auth.uid;
      let hasEmail = request.auth.token != null && 'email' in request.auth.token && request.auth.token.email != null;
      let email = hasEmail ? request.auth.token.email : '';
      
      return (hasEmail && exists(/databases/$(database)/documents/roles/$(email)))
        ? get(/databases/$(database)/documents/roles/$(email)).data.level
        : (exists(/databases/$(database)/documents/users/$(uid))
          ? get(/databases/$(database)/documents/users/$(uid)).data.role
          : 'Viewer');
    }

    function isAdmin() {
      let role = getUserRole();
      let hasEmail = request.auth.token != null && 'email' in request.auth.token && request.auth.token.email != null;
      let email = hasEmail ? request.auth.token.email : '';
      return role == 'Admin' || role == 'ADMIN' || role == 'admin' || role == 'Super Admin' || role == 'Env Manager' || role == 'Environment Manager'
        || email == 'environmentdivakencanaborneo@gmail.com'
        || email == 'admin@divaborneo.co.id';
    }

    function isSuperintendent() {
      let role = getUserRole();
      return isAdmin() || role == 'Superintendent' || role == 'SUPERINTENDENT' || role == 'superintendent' || role == 'Manager' || role == 'Environment Superintendent';
    }

    function isForeman() {
      let role = getUserRole();
      return isSuperintendent() || role == 'Foreman' || role == 'Supervisor';
    }

    function isOperator() {
      let role = getUserRole();
      return isForeman() || role == 'Operator' || role == 'OPERATOR' || role == 'operator';
    }

    // --- DOMAIN VALIDATORS ---

    function vWastewater() {
      let d = request.resource.data;
      return d.keys().hasAll(['id','date','location','officer','ph','tss','debit','fe','mn','status'])
        && shapeOk(25)
        && isValidDocId(d.id)
        && isText(d.date, 20)
        && isText(d.location, 150)
        && isText(d.officer, 100)
        && d.ph is number && d.ph >= 0 && d.ph <= 14
        && d.tss is number && d.tss >= 0
        && d.debit is number && d.debit >= 0
        && d.fe is number && d.fe >= 0
        && d.mn is number && d.mn >= 0
        && d.status in ['Safe', 'Warning', 'Exceeded']
        && (d.get('monitoringType', null) == null || d.monitoringType in ['Harian', 'Bulanan'])
        && (d.get('sampleTime', null) == null || (d.sampleTime is string && d.sampleTime.size() == 5))
        && (d.get('weather', null) == null || d.weather in ['Cerah', 'Berawan', 'Hujan Ringan', 'Hujan Lebat'])
        && isOptText(d.get('wastewaterSource', null), 150)
        && isOptText(d.get('locationCode', null), 50)
        && (d.get('hasPhoto', null) == null || d.hasPhoto is bool);
    }

    function vCapa() {
      let d = request.resource.data;
      return d.keys().hasAll(['id','source','title','status'])
        && shapeOk(30)
        && isValidDocId(d.id)
        && isText(d.title, 300)
        && isText(d.status, 50)
        && isText(d.source, 100)
        && isOptText(d.get('description', null), 4000)
        && isOptText(d.get('rootCause', null), 4000)
        && isOptText(d.get('correctiveAction', null), 4000)
        && isOptText(d.get('preventiveAction', null), 4000)
        && isOptText(d.get('verificationNotes', null), 4000)
        && isOptText(d.get('pic', null), 100);
    }

    function vEnvDocument() {
      let d = request.resource.data;
      return d.keys().hasAll(['id','name','type','docNo','issuedDate','expiryDate','status','pic'])
        && shapeOk(14)
        && isValidDocId(d.id)
        && isText(d.name, 300)
        && d.type in ['AMDAL','UKL-UPL','Persetujuan Lingkungan','Pertek Air Limbah',
                      'Pertek Emisi','Izin TPS B3','Izin Pemanfaatan',
                      'Persetujuan Rencana Reklamasi','Lainnya']
        && isText(d.docNo, 100)
        && isText(d.issuedDate, 50)
        && isText(d.expiryDate, 50)
        && isText(d.status, 50)
        && isText(d.pic, 100);
    }

    function vIncident() {
      let d = request.resource.data;
      return d.keys().hasAll(['id','title','date','severity','status'])
        && shapeOk(22)
        && isValidDocId(d.id)
        && isText(d.title, 300)
        && isText(d.date, 50)
        && isText(d.severity, 50)
        && isText(d.status, 50);
    }

    function vComplianceMatrix() {
      let d = request.resource.data;
      return d.keys().hasAll(['id','regulation','aspect','status'])
        && shapeOk(20)
        && isValidDocId(d.id)
        && isText(d.regulation, 300)
        && isText(d.aspect, 200)
        && isText(d.status, 50);
    }

    function vRegulatory() {
      let d = request.resource.data;
      return d.keys().hasAll(['id','title','category','status'])
        && shapeOk(20)
        && isValidDocId(d.id)
        && isText(d.title, 300)
        && isText(d.category, 100)
        && isText(d.status, 50);
    }

    // --- COLLECTION MATCHES ---

    // --- COLLECTION: users ---
    match /users/{userId} {
      allow read: if isVerifiedUser();
      allow create: if isVerifiedUser() && request.auth.uid == userId;
      allow update: if isVerifiedUser() && (
        isAdmin() || 
        request.auth.uid == userId
      );
      allow delete: if isAdmin();
    }
    
    // --- COLLECTION: roles ---
    match /roles/{email} {
      allow read: if isVerifiedUser();
      allow create, update, delete: if isAdmin();
    }

    // --- COLLECTION: audit_logs (IMMUTABLE APPEND-ONLY) ---
    match /audit_logs/{logId} {
      allow read: if isVerifiedUser();
      allow create: if isVerifiedUser();
      allow update: if false; // IMMUTABLE: Update denied
      allow delete: if false; // IMMUTABLE: Delete denied
    }

    // --- COLLECTION: app_meta ---
    match /app_meta/{metaId} {
      allow read: if isVerifiedUser();
      allow write: if isAdmin();
    }

    // --- DOMAIN DATA COLLECTIONS ---
    
    // Compliance Matrix
    match /compliance_matrix/{matrixId} {
      allow read: if isVerifiedUser();
      allow create, update: if (isOperator() || isVerifiedUser()) && vComplianceMatrix();
      allow delete: if isAdmin() || isSuperintendent();
    }
    
    // Regulatory Watch
    match /regulatory/{regId} {
      allow read: if isVerifiedUser();
      allow create, update: if (isSuperintendent() || isVerifiedUser()) && vRegulatory();
      allow delete: if isAdmin();
    }
    
    // Incidents
    match /incidents/{incidentId} {
      allow read: if isVerifiedUser();
      allow create, update: if (isOperator() || isVerifiedUser()) && vIncident();
      allow delete: if isAdmin() || isSuperintendent();
    }
    
    // CAPA Findings
    match /capa/{capaId} {
      allow read: if isVerifiedUser();
      allow create, update: if (isOperator() || isVerifiedUser()) && vCapa();
      allow delete: if isAdmin() || isSuperintendent();
    }

    // Notifications
    match /notifications/{notifId} {
      allow read: if isVerifiedUser();
      allow create: if isVerifiedUser();
      allow update: if isVerifiedUser();
      allow delete: if isVerifiedUser();
    }
    
    // Master Titik Sampling Air Limbah (Wewenang Superintendent ke atas)
    match /wq_locations/{id} {
      allow read: if isActiveMember();
      allow create, update: if isSuperintendent();
      allow delete: if false;
    }

    // Foto Sampling Air Limbah (Evidence visual terpisah)
    match /wastewater_photos/{id} {
      allow read: if isActiveMember();
      allow create, update: if isActiveMember() && isOperator() 
        && request.resource.data.dataUrl is string 
        && request.resource.data.dataUrl.size() <= 400000 
        && request.resource.data.mimeType == 'image/jpeg';
      allow delete: if isSuperintendent();
    }

    // Evidence Reports (Dokumen Evidence Harian & Rekap Bulanan)
    match /evidence_reports/{id} {
      allow read: if isActiveMember();
      allow create: if isActiveMember() && isOperator();
      allow update: if isActiveMember() && isOperator() && (
        // Draft edit
        (resource.data.status == 'Draft') ||
        // Status transition from Draft to Disiapkan
        (resource.data.status == 'Draft' && request.resource.data.status == 'Disiapkan') ||
        // Reviewed signature update by Foreman or higher, email != prepared.email
        (request.resource.data.status == 'Diperiksa' && isForeman() && request.resource.data.signatures.reviewed.email != resource.data.signatures.prepared.email) ||
        // Approved signature update by Admin/Manager, email != prepared.email and email != reviewed.email
        (request.resource.data.status == 'Disetujui' && isAdmin() && request.resource.data.signatures.approved.email != resource.data.signatures.prepared.email && request.resource.data.signatures.approved.email != resource.data.signatures.reviewed.email) ||
        // Superintendent revision update: revision number incremented
        (isSuperintendent() && request.resource.data.revision > resource.data.revision) ||
        // Admin cancellation:
        (isAdmin() && request.resource.data.status == 'Dibatalkan') ||
        // Immutable snapshot: snapshot & snapshotHash unchanged
        (request.resource.data.snapshotHash == resource.data.snapshotHash)
      );
      allow delete: if isAdmin() && resource.data.status == 'Draft';
    }

    // Counters (Atomic sequential numbering FR-EMS-WQ-YYYY-xxxxx)
    match /counters/{id} {
      allow read: if isActiveMember();
      allow create: if isActiveMember() && isOperator() && request.resource.data.value == 1;
      allow update: if isActiveMember() && isOperator() && request.resource.data.value == resource.data.value + 1;
      allow delete: if false;
    }

    // User Signatures (Tanda Tangan Digital Pengguna)
    match /signatures/{uid} {
      allow read: if isActiveMember();
      allow create, update: if request.auth.uid == uid && isActiveMember() 
        && request.resource.data.dataUrl is string 
        && request.resource.data.dataUrl.size() <= 80000;
      allow delete: if false;
    }

    // Public Verification Documents (Minimal data untuk scan QR Code tanpa login)
    match /evidence_verify/{token} {
      allow get: if true;
      allow list: if false;
      allow create, update: if isActiveMember() && isOperator();
      allow delete: if false;
    }
    
    // Environmental Monitoring Collections
    match /wastewater/{docId} {
      allow read: if isActiveMember() || isVerifiedUser();
      allow create, update: if (isOperator() || isVerifiedUser()) && vWastewater();
      allow delete: if isAdmin() || isSuperintendent();
    }
    
    match /surfacewater/{docId} {
      allow read: if isVerifiedUser();
      allow create, update: if isOperator() || isVerifiedUser();
      allow delete: if isAdmin() || isSuperintendent();
    }
    
    match /rainfall/{docId} {
      allow read: if isVerifiedUser();
      allow create, update: if isOperator() || isVerifiedUser();
      allow delete: if isAdmin() || isSuperintendent();
    }
    
    
    match /nursery_stock_out/{docId} {
      allow read: if isVerifiedUser();
      allow create, update: if isOperator() || isVerifiedUser();
      allow delete: if isAdmin() || isSuperintendent();
    }

    match /nursery/{docId} {
      allow read: if isVerifiedUser();
      allow create, update: if isOperator() || isVerifiedUser();
      allow delete: if isAdmin() || isSuperintendent();
    }
    
    match /solid_waste/{docId} {
      allow read: if isVerifiedUser();
      allow create, update: if isOperator() || isVerifiedUser();
      allow delete: if isAdmin() || isSuperintendent();
    }
    
    match /reclamation/{docId} {
      allow read: if isVerifiedUser();
      allow create, update: if isOperator() || isVerifiedUser();
      allow delete: if isAdmin() || isSuperintendent();
    }
    
    match /waste_b3/{docId} {
      allow read: if isVerifiedUser();
      allow create, update: if isOperator() || isVerifiedUser();
      allow delete: if isAdmin() || isSuperintendent();
    }
    
    match /documents/{docId} {
      allow read: if isVerifiedUser();
      allow create, update: if (isSuperintendent() || isVerifiedUser()) && vEnvDocument();
      allow delete: if isAdmin();
    }
    
    match /costs/{docId} {
      allow read: if isVerifiedUser();
      allow create, update: if isSuperintendent() || isVerifiedUser();
      allow delete: if isAdmin();
    }
    
    match /alerts/{docId} {
      allow read: if isVerifiedUser();
      allow create, update: if isOperator() || isVerifiedUser();
      allow delete: if isAdmin();
    }
  }
}
