    // [K-02] Validator Tanda Tangan Evidence
    function vEvidenceSignature(sig) {
      return sig is map
        && sig.keys().hasAll(['uid', 'email', 'name', 'position', 'signedAt', 'signatureDataUrl'])
        && sig.keys().hasOnly(['uid', 'email', 'name', 'position', 'signedAt', 'signatureDataUrl'])
        && isText(sig.uid, 128) && sig.uid.size() > 0
        && isText(sig.email, 120) && sig.email.size() > 0
        && isText(sig.name, 150) && sig.name.size() > 0
        && isText(sig.position, 150)
        && isText(sig.signedAt, 60)
        && sig.signatureDataUrl is string && sig.signatureDataUrl.size() <= 100000;
    }

