    function vDomesticWastewater(docId) {
      let d = request.resource.data;
      return d.keys().hasAll(['id','date','facilityName','ph','bod','cod','tss','oilGrease','ammonia','totalColiform','debitM3Day','officer'])
        && (isServerEvaluationEnabled() || 'complianceStatus' in d)
        && shapeOk(38)
        && d.id == docId
        && isValidDocId(d.id)
        && isText(d.date, 30)
        && isText(d.facilityName, 180)
        && isOptText(d.get('locationCode', null), 60)
        && (d.ph == null ? (d.get('missingReasons', null) is map && 'ph' in d.missingReasons) : (d.ph is number && d.ph >= 0 && d.ph <= 14))
        && (d.bod == null ? (d.get('missingReasons', null) is map && 'bod' in d.missingReasons) : (d.bod is number && d.bod >= 0))
        && (d.cod == null ? (d.get('missingReasons', null) is map && 'cod' in d.missingReasons) : (d.cod is number && d.cod >= 0))
        && (d.tss == null ? (d.get('missingReasons', null) is map && 'tss' in d.missingReasons) : (d.tss is number && d.tss >= 0))
        && (d.oilGrease == null ? (d.get('missingReasons', null) is map && 'oilGrease' in d.missingReasons) : (d.oilGrease is number && d.oilGrease >= 0))
        && (d.ammonia == null ? (d.get('missingReasons', null) is map && 'ammonia' in d.missingReasons) : (d.ammonia is number && d.ammonia >= 0))
        && (d.totalColiform == null ? (d.get('missingReasons', null) is map && 'totalColiform' in d.missingReasons) : (d.totalColiform is number && d.totalColiform >= 0))
        && (d.debitM3Day == null ? (d.get('missingReasons', null) is map && 'debitM3Day' in d.missingReasons) : (d.debitM3Day is number && d.debitM3Day >= 0))
        && (d.get('missingReasons', null) == null || d.missingReasons is map)
        && (d.get('evaluationHistory', null) == null || d.evaluationHistory is list)
        && (d.get('complianceStatus', null) == null || d.complianceStatus in ['Memenuhi', 'Warning', 'Tidak Memenuhi', 'Belum Ada Baku Mutu', 'Data Tidak Lengkap', 'Belum Dievaluasi', 'Tidak Berlaku'])
        && (d.get('evaluationStatus', null) == null || d.evaluationStatus in ['MEMENUHI', 'TIDAK MEMENUHI', 'DATA TIDAK LENGKAP', 'BELUM DIEVALUASI', 'TIDAK BERLAKU'])
        && isOptText(d.get('evaluationReason', null), 1000)
        && (d.get('unitMap', null) == null || d.unitMap is map)
        && isOptText(d.get('standardId', null), 128)
        && isOptText(d.get('standardBasis', null), 350)
        && (d.get('standardSnapshot', null) == null || d.standardSnapshot is map)
        && (d.get('serverEvaluatedAt', null) == null || d.serverEvaluatedAt is timestamp)
        && isOptText(d.get('correctionReason', null), 500)
        && isText(d.officer, 100)
        && isOptText(d.get('notes', null), 1000)
        && isOptText(d.get('createdBy', null), 100)
        && isOptText(d.get('updatedBy', null), 100);
    }

    // Faktor Emisi GRK Master Validator
    function vGhgFactor(docId) {
      let d = request.resource.data;
      return d.keys().hasAll(['id','activityCategory','factorName','unit','factorKgCo2ePerUnit','gasScope','referenceSource','effectiveYear'])
        && shapeOk(20)
        && d.id == docId
        && isValidDocId(d.id)
        && d.activityCategory in ['Solar Alat Berat & Hauling', 'Solar Genset & Pembangkit', 'Listrik PLN / Non-Tambang', 'Bahan Peledak (ANFO/Emulsi)', 'Perubahan Lahan Terbuka', 'Lainnya']
        && isText(d.factorName, 180)
        && isText(d.unit, 40)
        && d.factorKgCo2ePerUnit is number && d.factorKgCo2ePerUnit >= 0
        && d.gasScope in ['Scope 1 (Emisi Langsung)', 'Scope 2 (Energi Tidak Langsung)', 'Scope 3 / Lahan']
        && isText(d.referenceSource, 300)
        && d.effectiveYear is number && d.effectiveYear >= 2000 && d.effectiveYear <= 2100
        && isOptText(d.get('gwpReference', null), 200)
        && (d.get('verificationStatus', null) == null || d.verificationStatus in ['Terverifikasi', 'PERLU VERIFIKASI'])
        && isOptText(d.get('notes', null), 1000)
        && isOptText(d.get('createdBy', null), 100)
        && isOptText(d.get('updatedBy', null), 100);
    }

    // Log Aktivitas Emisi GRK Validator (emissionsTco2e nullable bila faktor belum tersedia/valid)
    function vGhgActivity(docId) {
      let d = request.resource.data;
      return d.keys().hasAll(['id','date','reportingYear','monthPeriod','activityCategory','sourceLocation','quantity','unit','emissionsTco2e','officer'])
        && shapeOk(32)
        && d.id == docId
        && isValidDocId(d.id)
        && isText(d.date, 30)
        && d.reportingYear is number && d.reportingYear >= 2000 && d.reportingYear <= 2100
        && isText(d.monthPeriod, 12)
        && d.activityCategory in ['Solar Alat Berat & Hauling', 'Solar Genset & Pembangkit', 'Listrik PLN / Non-Tambang', 'Bahan Peledak (ANFO/Emulsi)', 'Perubahan Lahan Terbuka', 'Lainnya']
        && isText(d.sourceLocation, 180)
        && d.quantity is number && d.quantity >= 0
        && isText(d.unit, 40)
        && isOptText(d.get('factorId', null), 128)
        && isOptText(d.get('factorNameSnapshot', null), 180)
        && (d.get('factorValueSnapshot', null) == null || d.factorValueSnapshot is number)
        && isOptText(d.get('referenceSourceSnapshot', null), 300)
        && isOptText(d.get('gasScopeSnapshot', null), 80)
        && isOptText(d.get('categorySnapshot', null), 120)
        && isOptText(d.get('unitSnapshot', null), 40)
        && (d.get('effectiveYearSnapshot', null) == null || d.effectiveYearSnapshot is number)
        && isOptText(d.get('gwpSnapshot', null), 200)
        && (d.get('verificationStatusSnapshot', null) == null || d.verificationStatusSnapshot in ['Terverifikasi', 'PERLU VERIFIKASI'])
        && (d.get('calculationStatus', null) == null || d.calculationStatus in ['TERHITUNG', 'BELUM TERHITUNG', 'PERLU VERIFIKASI'])
        && isOptText(d.get('calculationNote', null), 500)
        && (d.emissionsTco2e == null || (d.emissionsTco2e is number && d.emissionsTco2e >= 0))
        && isOptText(d.get('correctionReason', null), 500)
        && isText(d.officer, 100)
        && isOptText(d.get('notes', null), 1000)
        && isOptText(d.get('createdBy', null), 100)
        && isOptText(d.get('updatedBy', null), 100);
    }

    // --- COLLECTION MATCHES ---

    // --- COLLECTION: users ---
    match /users/{userId} {
      // Pemilik akun boleh membaca profil miliknya agar layar verifikasi/pending/suspended tampil tepat;
      // Admin/Manager yang aktif & terverifikasi boleh membaca dan mendaftar seluruh akun.
      allow get: if request.auth != null && (
        request.auth.uid == userId
        || (isActiveMember() && isAdmin())
      );
      allow list: if isActiveMember() && isAdmin();

      // Pendaftaran mandiri diizinkan HANYA sebagai Viewer + Pending + Belum Disetujui
      allow create: if request.auth != null
        && request.auth.uid == userId
        && (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid)
        && (!('email' in request.resource.data) || request.resource.data.email == request.auth.token.email)
        && (!('role' in request.resource.data) || request.resource.data.role == 'Viewer')
        && (!('isApproved' in request.resource.data) || request.resource.data.isApproved == false)
        && (!('status' in request.resource.data) || request.resource.data.status == 'Pending')
        && (!('isActive' in request.resource.data) || request.resource.data.isActive == true)
        && (!('deleted' in request.resource.data) || request.resource.data.deleted == false);

      // [K-03] Update profil non-hak-akses oleh user sendiri;
      // Perubahan field 'role' pada /users/{userId} hanya boleh oleh Strict Admin dan bukan untuk akun sendiri.
      allow update: if (
        isActiveMember() && isAdmin() && (
          request.resource.data.get('role', null) == resource.data.get('role', null)
          || (isStrictAdmin() && userId != request.auth.uid)
        )
      ) || (
        request.auth != null
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'isApproved', 'status', 'isActive', 'deleted',
          'uid', 'email', 'createdAt', 'approvedBy', 'approvedAt',
          'rejectedBy', 'rejectedAt', 'deletedBy', 'deletedAt', 'claimsUpdatedAt'
        ])
      );
      allow delete: if isActiveMember() && isStrictAdmin();
    }

    // --- COLLECTION: roles [K-03] ---
    match /roles/{email} {
      allow read: if isActiveMember() && (
        (request.auth.token != null && 'email' in request.auth.token && request.auth.token.email == email)
        || isAdmin()
      );
      allow create: if isActiveMember()
        && request.auth.token != null
        && 'email' in request.auth.token
        && request.auth.token.email != null
        && email != request.auth.token.email
        && isText(email, 128)
        && 'level' in request.resource.data
        && isText(request.resource.data.level, 60)
        && (
          isStrictAdmin()
          || (isManager() && request.resource.data.level in managerAssignableRoles())
        );
      allow update: if isActiveMember()
        && request.auth.token != null
        && 'email' in request.auth.token
        && request.auth.token.email != null
        && email != request.auth.token.email
        && 'level' in request.resource.data
        && isText(request.resource.data.level, 60)
        && (
          isStrictAdmin()
          || (
            isManager()
            && request.resource.data.level in managerAssignableRoles()
            && resource.data.level in managerAssignableRoles()
          )
        );
      allow delete: if isActiveMember() && isStrictAdmin();
    }

    // --- COLLECTION: audit_logs (IMMUTABLE APPEND-ONLY) ---
    match /audit_logs/{logId} {
      allow read: if isActiveMember() && (isSuperintendent() || isAuditor());
      allow create: if isActiveMember() && vAuditLog() && request.resource.data.id == logId;
      allow update: if false; // IMMUTABLE
      allow delete: if false; // IMMUTABLE
    }

    // --- COLLECTION: app_meta ---
    match /app_meta/{metaId} {
      allow read: if isActiveMember();
      allow write: if isActiveMember() && (isStrictAdmin() || (isSuperintendent() && metaId in ['env_thresholds', 'proper_criteria']));
    }

    // --- COLLECTION: standards (Master Baku Mutu Lingkungan Dinamis) ---
    match /standards/{docId} {
      allow read: if isActiveMember();
      allow create, update: if isActiveMember() && isSuperintendent() && vEnvironmentalStandard(docId);
      allow delete: if isActiveMember() && isAdmin();
    }

    // --- DOMAIN DATA COLLECTIONS ---

    // Compliance Matrix [T-03, S-07]
    match /compliance_matrix/{matrixId} {
      allow read: if isActiveMember();
      allow create: if isActiveMember() && isSuperintendent() && vComplianceMatrix(matrixId);
      allow update: if isActiveMember() && vComplianceMatrix(matrixId) && (
        isSuperintendent()
        || (isOperator() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['evidenceUrl', 'notes', 'updatedAt', 'updatedBy']))
      );
      allow delete: if isActiveMember() && isSuperintendent();
    }

    // Regulatory Watch
    match /regulatory/{regId} {
      allow read: if isActiveMember();
      allow create, update: if isActiveMember() && isSuperintendent() && vRegulatory(regId);
      allow delete: if isActiveMember() && isAdmin();
    }

    // Incidents
    match /incidents/{incidentId} {
      allow read: if isActiveMember();
      allow create, update: if isActiveMember() && isOperator() && vIncident(incidentId);
      allow delete: if isActiveMember() && isSuperintendent();
    }

    // CAPA Findings
    match /capa/{capaId} {
      allow read: if isActiveMember();
      allow create, update: if isActiveMember() && isOperator() && vCapa(capaId);
      allow delete: if isActiveMember() && isSuperintendent();
    }

    // Notifications & Alerts [S-07, S-08]
    match /notifications/{notifId} {
      allow read: if isActiveMember();
      allow create: if isActiveMember() && isOperator() && vNotification(notifId);
      allow update: if isActiveMember() && vNotification(notifId) && (
        isSuperintendent()
        || (
          resource.data.createdBy == request.auth.token.email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readBy', 'clearedBy'])
        )
        || (
          resource.data.createdBy == 'system'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy', 'clearedBy'])
          && request.resource.data.get('readBy', []).hasAll(resource.data.get('readBy', []))
          && request.resource.data.get('clearedBy', []).hasAll(resource.data.get('clearedBy', []))
          && request.resource.data.get('readBy', []).size() <= 100
          && request.resource.data.get('clearedBy', []).size() <= 100
          && request.resource.data.get('readBy', []).toSet().difference(resource.data.get('readBy', []).toSet()).hasOnly([request.auth.token.email])
          && request.resource.data.get('clearedBy', []).toSet().difference(resource.data.get('clearedBy', []).toSet()).hasOnly([request.auth.token.email])
        )
      );
      allow delete: if isActiveMember() && (
        isSuperintendent()
        || resource.data.createdBy == request.auth.token.email
      );
    }

    match /alerts/{docId} {
      allow read: if isActiveMember();
      allow create: if isActiveMember() && isOperator() && vNotification(docId);
      allow update: if isActiveMember() && vNotification(docId) && (
        isSuperintendent()
        || (
          resource.data.createdBy == request.auth.token.email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readBy', 'clearedBy'])
        )
        || (
          resource.data.createdBy == 'system'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy', 'clearedBy'])
          && request.resource.data.get('readBy', []).hasAll(resource.data.get('readBy', []))
          && request.resource.data.get('clearedBy', []).hasAll(resource.data.get('clearedBy', []))
          && request.resource.data.get('readBy', []).size() <= 100
          && request.resource.data.get('clearedBy', []).size() <= 100
          && request.resource.data.get('readBy', []).toSet().difference(resource.data.get('readBy', []).toSet()).hasOnly([request.auth.token.email])
          && request.resource.data.get('clearedBy', []).toSet().difference(resource.data.get('clearedBy', []).toSet()).hasOnly([request.auth.token.email])
        )
      );
      allow delete: if isActiveMember() && isSuperintendent();
    }

    // Master Titik Sampling Air Limbah (Wewenang Superintendent ke atas)
    match /wq_locations/{id} {
      allow read: if isActiveMember();
      allow create, update: if isActiveMember() && isSuperintendent()
        && (!('id' in request.resource.data) || request.resource.data.id == id);
      allow delete: if false;
    }

    // Foto Sampling Air Limbah (Evidence visual terpisah)
    match /wastewater_photos/{id} {
      allow read: if isActiveMember();
      allow create, update: if isActiveMember() && isOperator()
        && (!('id' in request.resource.data) || request.resource.data.id == id)
        && request.resource.data.dataUrl is string
        && request.resource.data.dataUrl.size() <= 400000
        && request.resource.data.mimeType == 'image/jpeg';
      allow delete: if isActiveMember() && isSuperintendent();
    }

    // Evidence Reports (Dokumen Evidence Harian & Rekap Bulanan) [K-02 + Backend Callable Gate]
    match /evidence_reports/{id} {
      allow read: if isActiveMember();
      allow create: if !isServerEvidenceEnabled()
        && isActiveMember() && isOperator()
        && vEvidenceReport(id)
        && request.resource.data.status == 'Disiapkan'
        && request.resource.data.revision == 0
        && request.resource.data.signatures.keys().hasOnly(['prepared'])
        && vEvidenceSignature(request.resource.data.signatures.prepared)
        && request.resource.data.signatures.prepared.uid == request.auth.uid
        && request.resource.data.signatures.prepared.email == request.auth.token.email
        && request.resource.data.createdBy == request.auth.token.email;
      allow update: if !isServerEvidenceEnabled()
        && isActiveMember()
        && vEvidenceReport(id)
        && request.resource.data.documentNo == resource.data.documentNo
        && request.resource.data.type == resource.data.type
        && request.resource.data.createdBy == resource.data.createdBy
        && (
          // 1. Disiapkan -> Diperiksa (Foreman+, berbeda dari penyiap, snapshotHash terkunci)
          (
            isForeman()
            && resource.data.status == 'Disiapkan'
            && request.resource.data.status == 'Diperiksa'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['signatures', 'status', 'updatedAt', 'updatedBy'])
            && request.resource.data.signatures.keys().hasOnly(['prepared', 'reviewed'])
            && request.resource.data.signatures.prepared == resource.data.signatures.prepared
            && vEvidenceSignature(request.resource.data.signatures.reviewed)
            && request.resource.data.signatures.reviewed.uid == request.auth.uid
            && request.resource.data.signatures.reviewed.email == request.auth.token.email
            && request.resource.data.signatures.reviewed.email != resource.data.signatures.prepared.email
            && request.resource.data.snapshotHash == resource.data.snapshotHash
          )
          // 2. Diperiksa -> Disetujui (Manager/Admin, berbeda dari penyiap & pemeriksa, snapshotHash terkunci)
          || (
            isAdmin()
            && resource.data.status == 'Diperiksa'
            && request.resource.data.status == 'Disetujui'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['signatures', 'status', 'updatedAt', 'updatedBy'])
            && request.resource.data.signatures.keys().hasOnly(['prepared', 'reviewed', 'approved'])
            && request.resource.data.signatures.prepared == resource.data.signatures.prepared
            && request.resource.data.signatures.reviewed == resource.data.signatures.reviewed
            && vEvidenceSignature(request.resource.data.signatures.approved)
            && request.resource.data.signatures.approved.uid == request.auth.uid
            && request.resource.data.signatures.approved.email == request.auth.token.email
            && request.resource.data.signatures.approved.email != resource.data.signatures.prepared.email
            && request.resource.data.signatures.approved.email != resource.data.signatures.reviewed.email
            && request.resource.data.snapshotHash == resource.data.snapshotHash
          )
          // 3. Terbit Revisi (Superintendent+, bukan dari Dibatalkan, reset TTD ke penyiap baru)
          || (
            isSuperintendent()
            && resource.data.status != 'Dibatalkan'
            && request.resource.data.status == 'Disiapkan'
            && request.resource.data.revision == resource.data.revision + 1
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revision', 'snapshot', 'snapshotHash', 'status', 'signatures', 'revisionHistory', 'updatedAt', 'updatedBy'])
            && request.resource.data.signatures.keys().hasOnly(['prepared'])
            && vEvidenceSignature(request.resource.data.signatures.prepared)
            && request.resource.data.signatures.prepared.uid == request.auth.uid
            && request.resource.data.signatures.prepared.email == request.auth.token.email
            && request.resource.data.revisionHistory is list
            && request.resource.data.revisionHistory.size() == resource.data.get('revisionHistory', []).size() + 1
          )
          // 4. Pembatalan Dokumen (Manager/Admin, bukan dari Dibatalkan, alasan >= 10 karakter)
          || (
            isAdmin()
            && resource.data.status != 'Dibatalkan'
            && request.resource.data.status == 'Dibatalkan'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancellationReason', 'updatedAt', 'updatedBy'])
            && request.resource.data.cancellationReason is string
            && request.resource.data.cancellationReason.size() >= 10
            && request.resource.data.cancellationReason.size() <= 500
          )
        );
      allow delete: if !isServerEvidenceEnabled() && isActiveMember() && isAdmin() && resource.data.status == 'Draft';
    }

    // Counters (Atomic sequential numbering FR-EMS-WQ-YYYY-xxxxx) [S-08 + K-02 Server Gate]
    match /counters/{id} {
      allow read: if isActiveMember();
      allow create: if !isServerEvidenceEnabled()
        && isActiveMember() && isOperator()
        && id.matches('^evidence(-daily-|_)[0-9]{4}$')
        && request.resource.data.value == 1
        && request.resource.data.keys().hasAll(['value', 'updatedAt', 'lastReportId'])
        && shapeOk(4)
        && isValidDocId(request.resource.data.lastReportId)
        && existsAfter(/databases/$(database)/documents/evidence_reports/$(request.resource.data.lastReportId));
      allow update: if !isServerEvidenceEnabled()
        && isActiveMember() && isOperator()
        && id.matches('^evidence(-daily-|_)[0-9]{4}$')
        && request.resource.data.value == resource.data.value + 1
        && request.resource.data.keys().hasAll(['value', 'updatedAt', 'lastReportId'])
        && shapeOk(4)
        && isValidDocId(request.resource.data.lastReportId)
        && existsAfter(/databases/$(database)/documents/evidence_reports/$(request.resource.data.lastReportId));
      allow delete: if false;
    }

    // User Signatures [K-02: Hanya pemilik yang dapat membaca/mengubah]
    match /signatures/{uid} {
      allow read: if isActiveMember() && request.auth.uid == uid;
      allow create, update: if request.auth.uid == uid && isActiveMember()
        && request.resource.data.dataUrl is string
        && request.resource.data.dataUrl.size() <= 80000;
      allow delete: if false;
    }

    // Public Verification Documents (Minimal data untuk scan QR Code tanpa login) [K-02, K-01]
    match /evidence_verify/{token} {
      allow get: if true;
      allow list: if false;
      allow create: if !isServerEvidenceEnabled()
        && isActiveMember() && vEvidenceVerify() && (
        (
          isOperator()
          && request.resource.data.status == 'Disiapkan'
          && existsAfter(/databases/$(database)/documents/evidence_reports/$(request.resource.data.reportId))
          && getAfter(/databases/$(database)/documents/evidence_reports/$(request.resource.data.reportId)).data.verifyToken == token
          && getAfter(/databases/$(database)/documents/evidence_reports/$(request.resource.data.reportId)).data.status == request.resource.data.status
          && getAfter(/databases/$(database)/documents/evidence_reports/$(request.resource.data.reportId)).data.documentNo == request.resource.data.documentNo
        ) || (
          isStrictAdmin()
          && exists(/databases/$(database)/documents/evidence_reports/$(request.resource.data.reportId))
          && get(/databases/$(database)/documents/evidence_reports/$(request.resource.data.reportId)).data.verifyToken == token
          && get(/databases/$(database)/documents/evidence_reports/$(request.resource.data.reportId)).data.status == request.resource.data.status
          && get(/databases/$(database)/documents/evidence_reports/$(request.resource.data.reportId)).data.documentNo == request.resource.data.documentNo
        )
      );
      allow update: if !isServerEvidenceEnabled()
        && isActiveMember() && vEvidenceVerify() && (
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportId', 'status', 'overall', 'hashPrefix'])
          && existsAfter(/databases/$(database)/documents/evidence_reports/$(request.resource.data.reportId))
          && getAfter(/databases/$(database)/documents/evidence_reports/$(request.resource.data.reportId)).data.verifyToken == token
          && getAfter(/databases/$(database)/documents/evidence_reports/$(request.resource.data.reportId)).data.status == request.resource.data.status
          && getAfter(/databases/$(database)/documents/evidence_reports/$(request.resource.data.reportId)).data.documentNo == request.resource.data.documentNo
          && (
            (request.resource.data.status == 'Disiapkan' && isSuperintendent()) ||
            (request.resource.data.status == 'Diperiksa' && isForeman()) ||
            (request.resource.data.status == 'Disetujui' && isAdmin()) ||
            (request.resource.data.status == 'Dibatalkan' && isAdmin())
          )
        ) || (
          isStrictAdmin()
          && exists(/databases/$(database)/documents/evidence_reports/$(request.resource.data.reportId))
          && get(/databases/$(database)/documents/evidence_reports/$(request.resource.data.reportId)).data.verifyToken == token
          && get(/databases/$(database)/documents/evidence_reports/$(request.resource.data.reportId)).data.status == request.resource.data.status
          && get(/databases/$(database)/documents/evidence_reports/$(request.resource.data.reportId)).data.documentNo == request.resource.data.documentNo
        )
      );
      allow delete: if false;
    }

    // Environmental Monitoring Collections [D-01 + K-04 Server Evaluation Gate]
    match /wastewater/{docId} {
      allow read: if isActiveMember();
      allow create: if isActiveMember() && isOperator() && vWastewater(docId)
        && !('evaluationHistory' in request.resource.data)
        && (
          !isServerEvaluationEnabled()
          || !request.resource.data.keys().hasAny([
            'status', 'complianceStatus', 'evaluationStatus', 'evaluationReason',
            'standardBasis', 'standardId', 'standardSnapshot', 'serverEvaluatedAt', 'evaluationHistory'
          ])
        );
      allow update: if isActiveMember() && vWastewater(docId) && (
        (
          isServerEvaluationEnabled()
          && isOperator()
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'status', 'complianceStatus', 'evaluationStatus', 'evaluationReason',
            'standardBasis', 'standardId', 'standardSnapshot', 'serverEvaluatedAt', 'evaluationHistory'
          ])
        ) || (
          !isServerEvaluationEnabled() && (
            (
              isSuperintendent()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status', 'evaluationStatus', 'evaluationReason',
                'standardId', 'standardBasis', 'standardSnapshot',
                'correctionReason', 'evaluationHistory', 'updatedAt', 'updatedBy'
              ])
              && request.resource.data.correctionReason is string
              && request.resource.data.correctionReason.size() >= 20
            ) || (
              isOperator()
              && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['evaluationHistory'])
            )
          )
        )
      );
      allow delete: if isActiveMember() && isSuperintendent();
    }

    match /surfacewater/{docId} {
      allow read: if isActiveMember();
      allow create: if isActiveMember() && isOperator() && vSurfaceWater(docId)
        && !('evaluationHistory' in request.resource.data)
        && (
          !isServerEvaluationEnabled()
          || !request.resource.data.keys().hasAny([
            'status', 'complianceStatus', 'evaluationStatus', 'evaluationReason',
            'standardBasis', 'standardId', 'standardSnapshot', 'serverEvaluatedAt', 'evaluationHistory'
          ])
        );
      allow update: if isActiveMember() && vSurfaceWater(docId) && (
        (
          isServerEvaluationEnabled()
          && isOperator()
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'status', 'complianceStatus', 'evaluationStatus', 'evaluationReason',
            'standardBasis', 'standardId', 'standardSnapshot', 'serverEvaluatedAt', 'evaluationHistory'
          ])
        ) || (
          !isServerEvaluationEnabled() && (
            (
              isSuperintendent()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status', 'evaluationStatus', 'evaluationReason',
                'standardId', 'standardBasis', 'standardSnapshot',
                'correctionReason', 'evaluationHistory', 'updatedAt', 'updatedBy'
              ])
              && request.resource.data.correctionReason is string
              && request.resource.data.correctionReason.size() >= 20
            ) || (
              isOperator()
              && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['evaluationHistory'])
            )
          )
        )
      );
      allow delete: if isActiveMember() && isSuperintendent();
    }

    match /rainfall/{docId} {
      allow read: if isActiveMember();
      allow create, update: if isActiveMember() && isOperator() && vRainfall(docId);
      allow delete: if isActiveMember() && isSuperintendent();
    }

    match /nursery_stock_out/{docId} {
      allow read: if isActiveMember();
      allow create, update: if isActiveMember() && isOperator() && vNurseryStockOut(docId);
      allow delete: if isActiveMember() && isSuperintendent();
    }

    match /nursery/{docId} {
      allow read: if isActiveMember();
      allow create, update: if isActiveMember() && isOperator() && vNursery(docId);
      allow delete: if isActiveMember() && isSuperintendent();
    }

    match /solid_waste/{docId} {
      allow read: if isActiveMember();
      allow create, update: if isActiveMember() && isOperator() && vSolidWaste(docId);
      allow delete: if isActiveMember() && isSuperintendent();
    }

    // [T-02, T-03, S-07] RP-* terbuka baca & operator tulis; RG-* (jaminan finansial) rahasia Superintendent+/Auditor & tulis Superintendent+
    match /reclamation/{docId} {
      allow read: if isActiveMember() && (
        (docId >= 'RP-' && docId < 'RP.')
        || docId.matches('^RP-.*')
        || ((isSuperintendent() || isAuditorRole()) && (
          (docId >= 'RG-' && docId < 'RG.')
          || docId.matches('^RG-.*')
        ))
      );
      allow create, update: if isActiveMember() && (
        (docId.matches('^RP-.*') && isOperator() && vReclamationPlan(docId)) ||
        (docId.matches('^RG-.*') && isSuperintendent() && vReclamationGuarantee(docId))
      );
      allow delete: if isActiveMember() && isSuperintendent();
    }

    match /waste_b3/{docId} {
      allow read: if isActiveMember();
      allow create, update: if isActiveMember() && isOperator() && (
        (docId.matches('^WI-.*') && vWasteIn(docId)) ||
        (docId.matches('^WO-.*') && vWasteOut(docId))
      );
      allow delete: if isActiveMember() && isSuperintendent();
    }

    match /documents/{docId} {
      allow read: if isActiveMember();
      allow create, update: if isActiveMember() && (
        (docId.matches('^DOC-.*') && isSuperintendent() && vEnvDocument(docId)) ||
        (docId.matches('^EV-.*') && isOperator() && vComplianceEvent(docId))
      );
      allow delete: if isActiveMember() && (isAdmin() || (docId.matches('^EV-.*') && isSuperintendent()));
    }

    // [T-02] Anggaran & Biaya Lingkungan hanya untuk Superintendent ke atas & Auditor
    match /costs/{docId} {
      allow read: if isActiveMember() && (isSuperintendent() || isAuditorRole());
      allow create, update: if isActiveMember() && isSuperintendent() && vCost(docId);
      allow delete: if isActiveMember() && isAdmin();
    }

    match /amd_treatment/{docId} {
      allow read: if isActiveMember();
      allow create, update: if isActiveMember() && isOperator() && vAmdTreatment(docId);
      allow delete: if isActiveMember() && isSuperintendent();
    }

    match /air_emission/{docId} {
      allow read: if isActiveMember();
      allow create, update: if isActiveMember() && isOperator() && vAirEmission(docId);
      allow delete: if isActiveMember() && isSuperintendent();
    }

    match /topsoil_erosion/{docId} {
      allow read: if isActiveMember();
      allow create, update: if isActiveMember() && isOperator() && vTopsoilErosion(docId);
      allow delete: if isActiveMember() && isSuperintendent();
    }

    match /biodiversity/{docId} {
      allow read: if isActiveMember();
      allow create, update: if isActiveMember() && isOperator() && vBiodiversity(docId);
      allow delete: if isActiveMember() && isSuperintendent();
    }

    match /iadl_risk/{docId} {
      allow read: if isActiveMember();
      allow create, update: if isActiveMember() && isOperator() && vIadlRisk(docId);
      allow delete: if isActiveMember() && isSuperintendent();
    }

    // [T-02] PROPER & RKAB hanya untuk Superintendent ke atas & Auditor
    match /proper_rkab/{docId} {
      allow read: if isActiveMember() && (isSuperintendent() || isAuditorRole());
      allow create, update: if isActiveMember() && isSuperintendent() && vProperRkab(docId);
      allow delete: if isActiveMember() && isSuperintendent();
    }

    // [T-03] Master Register Pertek & SLO hanya Superintendent+
    match /pertek_slo/{docId} {
      allow read: if isActiveMember();
      allow create, update: if isActiveMember() && isSuperintendent() && vPertekSlo(docId);
      allow delete: if isActiveMember() && isSuperintendent();
    }

    // [T-03] Master Kalender Pelaporan Wajib hanya Superintendent+
    match /reporting_calendar/{docId} {
      allow read: if isActiveMember();
      allow create, update: if isActiveMember() && isSuperintendent() && vReportingCalendar(docId);
      allow delete: if isActiveMember() && isSuperintendent();
    }

    match /external_supervisions/{docId} {
      allow read: if isActiveMember();
      allow create, update: if isActiveMember() && isOperator() && vExternalSupervision(docId);
      allow delete: if isActiveMember() && isSuperintendent();
    }

    match /domestic_wastewater/{docId} {
      allow read: if isActiveMember();
      allow create: if isActiveMember() && isOperator() && vDomesticWastewater(docId)
        && !('evaluationHistory' in request.resource.data)
        && (
          !isServerEvaluationEnabled()
          || !request.resource.data.keys().hasAny([
            'status', 'complianceStatus', 'evaluationStatus', 'evaluationReason',
            'standardBasis', 'standardId', 'standardSnapshot', 'serverEvaluatedAt', 'evaluationHistory'
          ])
        );
      allow update: if isActiveMember() && vDomesticWastewater(docId) && (
        (
          isServerEvaluationEnabled()
          && isOperator()
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'status', 'complianceStatus', 'evaluationStatus', 'evaluationReason',
            'standardBasis', 'standardId', 'standardSnapshot', 'serverEvaluatedAt', 'evaluationHistory'
          ])
        ) || (
          !isServerEvaluationEnabled() && (
            (
              isSuperintendent()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'complianceStatus', 'evaluationStatus', 'evaluationReason',
                'standardId', 'standardBasis', 'standardSnapshot',
                'correctionReason', 'evaluationHistory', 'updatedAt', 'updatedBy'
              ])
              && request.resource.data.correctionReason is string
              && request.resource.data.correctionReason.size() >= 20
            ) || (
              isOperator()
              && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['evaluationHistory'])
            )
          )
        )
      );
      allow delete: if isActiveMember() && isSuperintendent();
    }

    // [T-03] Master Faktor Emisi GRK hanya Superintendent+
    match /ghg_factors/{docId} {
      allow read: if isActiveMember();
      allow create, update: if isActiveMember() && isSuperintendent() && vGhgFactor(docId);
      allow delete: if isActiveMember() && isSuperintendent();
    }

    match /ghg_activities/{docId} {
      allow read: if isActiveMember();
      allow create, update: if isActiveMember() && isOperator() && vGhgActivity(docId);
      allow delete: if isActiveMember() && isSuperintendent();
    }
  }
}
